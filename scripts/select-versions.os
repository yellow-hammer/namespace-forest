// Отбирает версии платформы из JSON yard: >= MIN_VERSION и еще не обработаны.
// Параметры через переменные среды:
//   YARD_JSON   - JSON от yard releases list
//   PROCESSED   - schemas/processed-versions.json
//   MIN_VERSION - нижняя граница (X.Y.Z)
//   LIMIT       - максимум версий за прогон (0 - без ограничения)
//   OUT_FILE    - куда записать отобранные версии (по строке)

Функция ОбязательнаяПеременнаяСреды(Знач Имя)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не задана переменная среды " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КомпонентыВерсии(Знач Текст)
	Компоненты = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ".", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если ТолькоЦифры(Часть) Тогда
			Компоненты.Добавить(Число(СокрЛП(Часть)));
		Иначе
			Компоненты.Добавить(0);
		КонецЕсли;
	КонецЦикла;
	Пока Компоненты.Количество() < 4 Цикл
		Компоненты.Добавить(0);
	КонецЦикла;
	Возврат Компоненты;
КонецФункции

Функция ТолькоЦифры(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

Функция НеНижеМинимума(Знач Кортеж, Знач Минимум)
	Для Индекс = 0 По 2 Цикл
		Если Кортеж[Индекс] > Минимум[Индекс] Тогда
			Возврат Истина;
		КонецЕсли;
		Если Кортеж[Индекс] < Минимум[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПрочитатьJSONФайл(Знач ИмяФайла)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ПрочитатьОбработанныеВерсии(Знач ФайлОбработанных)
	Обработанные = Новый Соответствие;
	Если Не Новый Файл(ФайлОбработанных).Существует() Тогда
		Возврат Обработанные;
	КонецЕсли;

	ДанныеОбработанных = ПрочитатьJSONФайл(ФайлОбработанных);
	Для Каждого ЭлементКлюч Из ДанныеОбработанных Цикл
		Если Лев(ЭлементКлюч.Ключ, 1) <> "_" Тогда
			Обработанные.Вставить(ЭлементКлюч.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Обработанные;
КонецФункции

Процедура ДобавитьКолонкиВерсии(Знач Таблица)
	Таблица.Колонки.Добавить("Версия");
	Таблица.Колонки.Добавить("Часть1");
	Таблица.Колонки.Добавить("Часть2");
	Таблица.Колонки.Добавить("Часть3");
	Таблица.Колонки.Добавить("Часть4");
КонецПроцедуры

Процедура ДобавитьВерсию(Знач Таблица, Знач Версия, Знач Кортеж)
	Строка = Таблица.Добавить();
	Строка.Версия = Версия;
	Строка.Часть1 = Кортеж[0];
	Строка.Часть2 = Кортеж[1];
	Строка.Часть3 = Кортеж[2];
	Строка.Часть4 = Кортеж[3];
КонецПроцедуры

Процедура ДобавитьВерсииПриложения(Знач Таблица, Знач Версии, Знач Обработанные, Знач МинимумКортеж)
	Для Каждого ОписаниеВерсии Из Версии Цикл
		Версия = ОписаниеВерсии.Получить("Версия");
		Если Версия = Неопределено Или ПустаяСтрока(Версия) Тогда
			Продолжить;
		КонецЕсли;
		Если ОписаниеВерсии.Получить("Бета") = Истина Тогда
			Продолжить;
		КонецЕсли;
		Кортеж = КомпонентыВерсии(Версия);
		Если Не НеНижеМинимума(Кортеж, МинимумКортеж) Тогда
			Продолжить;
		КонецЕсли;
		Если Обработанные.Получить(Версия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьВерсию(Таблица, Версия, Кортеж);
	КонецЦикла;
КонецПроцедуры

Функция ОтобратьВерсии(Знач Приложения, Знач Обработанные, Знач МинимумКортеж)
	Таблица = Новый ТаблицаЗначений;
	ДобавитьКолонкиВерсии(Таблица);

	Для Каждого Приложение Из Приложения Цикл
		Версии = Приложение.Получить("Версии");
		КоличествоВерсий = ?(Версии = Неопределено, 0, Версии.Количество());
		ИмяПриложения = Приложение.Получить("Имя");
		Если ИмяПриложения = Неопределено Тогда
			ИмяПриложения = "<без имени>";
		КонецЕсли;
		Сообщить("  " + ИмяПриложения + ": " + КоличествоВерсий + " версий");
		Если Версии <> Неопределено Тогда
			ДобавитьВерсииПриложения(Таблица, Версии, Обработанные, МинимумКортеж);
		КонецЕсли;
	КонецЦикла;

	Таблица.Сортировать("Часть1, Часть2, Часть3, Часть4");
	Возврат Таблица;
КонецФункции

Функция ЗаписатьВерсии(Знач Таблица, Знач Лимит, Знач ВыходнойФайл)
	Содержимое = "";
	Отобрано = 0;
	Для Каждого Строка Из Таблица Цикл
		Если Лимит > 0 И Отобрано >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Содержимое = Содержимое + Строка.Версия + Символы.ПС;
		Отобрано = Отобрано + 1;
	КонецЦикла;
	ПолучитьДвоичныеДанныеИзСтроки(Содержимое, "UTF-8", Ложь).Записать(ВыходнойФайл);
	Возврат Отобрано;
КонецФункции

ЯрдФайл = ОбязательнаяПеременнаяСреды("YARD_JSON");
ФайлОбработанных = ОбязательнаяПеременнаяСреды("PROCESSED");
МинимумКортеж = КомпонентыВерсии(ОбязательнаяПеременнаяСреды("MIN_VERSION"));
ВыходнойФайл = ОбязательнаяПеременнаяСреды("OUT_FILE");
СтрЛимит = ПолучитьПеременнуюСреды("LIMIT");
Лимит = ?(ПустаяСтрока(СтрЛимит), 0, Число(СтрЛимит));

Приложения = ПрочитатьJSONФайл(ЯрдФайл);
Обработанные = ПрочитатьОбработанныеВерсии(ФайлОбработанных);
Таблица = ОтобратьВерсии(Приложения, Обработанные, МинимумКортеж);
Отобрано = ЗаписатьВерсии(Таблица, Лимит, ВыходнойФайл);
Сообщить("Отобрано версий: " + Отобрано);
