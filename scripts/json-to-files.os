// JSON "имя.xsd -> содержимое" (ответ HTTP-сервиса) раскладывает по файлам.
// Параметры через переменные среды:
//   JSON_IN - файл с JSON
//   OUT_DIR - каталог для *.xsd

Функция ОбязательнаяПеременнаяСреды(Знач Имя)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не задана переменная среды " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

ВходнойФайл = ОбязательнаяПеременнаяСреды("JSON_IN");
Каталог = ОбязательнаяПеременнаяСреды("OUT_DIR");

Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(ВходнойФайл);
Данные = ПрочитатьJSON(Чтение, Истина);
Чтение.Закрыть();

Счётчик = 0;
Для Каждого ЭлементКлюч Из Данные Цикл
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ЭлементКлюч.Значение, "UTF-8", Ложь);
	ДвоичныеДанные.Записать(ОбъединитьПути(Каталог, ЭлементКлюч.Ключ));
	Счётчик = Счётчик + 1;
КонецЦикла;
Сообщить("Записано XSD-файлов: " + Счётчик);
