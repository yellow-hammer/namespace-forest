// Обновляет schemas/processed-versions.json парами "версия формат" из MAP_FILE.
// Ключи сортируются по версии, _comment остается первым.
// Параметры через переменные среды:
//   MAP_FILE  - строки "X.Y.Z.W формат"
//   PROCESSED - путь к processed-versions.json

Функция ОбязательнаяПеременнаяСреды(Знач Имя)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не задана переменная среды " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КомпонентыВерсии(Знач Текст)
	Компоненты = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ".", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если ТолькоЦифры(Часть) Тогда
			Компоненты.Добавить(Число(СокрЛП(Часть)));
		Иначе
			Компоненты.Добавить(0);
		КонецЕсли;
	КонецЦикла;
	Пока Компоненты.Количество() < 4 Цикл
		Компоненты.Добавить(0);
	КонецЦикла;
	Возврат Компоненты;
КонецФункции

Функция ТолькоЦифры(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

Процедура ПрочитатьСуществующиеВерсии(Знач ФайлJSON, Знач Данные)
	Если Не Новый Файл(ФайлJSON).Существует() Тогда
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ФайлJSON);
	Существующие = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Для Каждого ЭлементКлюч Из Существующие Цикл
		Если ЭлементКлюч.Ключ <> "_comment" Тогда
			Данные.Вставить(ЭлементКлюч.Ключ, ЭлементКлюч.Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

МапФайл = ОбязательнаяПеременнаяСреды("MAP_FILE");
ФайлJSON = ОбязательнаяПеременнаяСреды("PROCESSED");
Комментарий = "версия платформы → версия формата (каталог schemas/<X>)";

Данные = Новый Соответствие;
ПрочитатьСуществующиеВерсии(ФайлJSON, Данные);

Добавлено = 0;
ЧтениеТекста = Новый ЧтениеТекста(МапФайл, КодировкаТекста.UTF8);
Строка = ЧтениеТекста.ПрочитатьСтроку();
Пока Строка <> Неопределено Цикл
	Части = СтрРазделить(СокрЛП(Строка), " ", Ложь);
	Если Части.Количество() = 2 Тогда
		Данные.Вставить(Части[0], Части[1]);
		Добавлено = Добавлено + 1;
	КонецЕсли;
	Строка = ЧтениеТекста.ПрочитатьСтроку();
КонецЦикла;
ЧтениеТекста.Закрыть();

Таблица = Новый ТаблицаЗначений;
Таблица.Колонки.Добавить("Ключ");
Таблица.Колонки.Добавить("Часть1");
Таблица.Колонки.Добавить("Часть2");
Таблица.Колонки.Добавить("Часть3");
Таблица.Колонки.Добавить("Часть4");
Для Каждого ЭлементКлюч Из Данные Цикл
	Компоненты = КомпонентыВерсии(ЭлементКлюч.Ключ);
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Ключ = ЭлементКлюч.Ключ;
	НоваяСтрока.Часть1 = Компоненты[0];
	НоваяСтрока.Часть2 = Компоненты[1];
	НоваяСтрока.Часть3 = Компоненты[2];
	НоваяСтрока.Часть4 = Компоненты[3];
КонецЦикла;
Таблица.Сортировать("Часть1, Часть2, Часть3, Часть4");

Результат = Новый Соответствие;
Результат.Вставить("_comment", Комментарий);
Для Каждого Строка Из Таблица Цикл
	Результат.Вставить(Строка.Ключ, Данные.Получить(Строка.Ключ));
КонецЦикла;

Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
ЗаписатьJSON(Запись, Результат);
ПолучитьДвоичныеДанныеИзСтроки(Запись.Закрыть() + Символы.ПС, "UTF-8", Ложь).Записать(ФайлJSON);
Сообщить("processed-versions.json: добавлено/обновлено " + Добавлено + " версий");
