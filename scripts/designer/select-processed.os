// Отбирает по одной версии платформы на каждый формат из уже обработанных - для повторной выгрузки схем.
// Нужен, когда меняется состав выгружаемых пакетов: старые каталоги schemas/<формат> надо перезаписать.
// Параметры через переменные среды:
//   PROCESSED - schemas/processed-versions.json
//   OUT_FILE  - куда записать отобранные версии (по строке)

Функция ОбязательнаяПеременнаяСреды(Знач Имя)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не задана переменная среды " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КомпонентыВерсии(Знач Текст)
	Компоненты = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ".", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Компоненты.Добавить(?(ТолькоЦифры(Часть), Число(Часть), 0));
	КонецЦикла;
	Пока Компоненты.Количество() < 4 Цикл
		Компоненты.Добавить(0);
	КонецЦикла;
	Возврат Компоненты;
КонецФункции

Функция ТолькоЦифры(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

Функция ПрочитатьJSONФайл(Знач ИмяФайла)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайла);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция СтаршаяВерсия(Знач Первая, Знач Вторая)
	Если Первая = Неопределено Тогда
		Возврат Вторая;
	КонецЕсли;

	КортежПервой = КомпонентыВерсии(Первая);
	КортежВторой = КомпонентыВерсии(Вторая);
	Для Индекс = 0 По 3 Цикл
		Если КортежПервой[Индекс] <> КортежВторой[Индекс] Тогда
			Возврат ?(КортежПервой[Индекс] > КортежВторой[Индекс], Первая, Вторая);
		КонецЕсли;
	КонецЦикла;
	Возврат Первая;
КонецФункции

ФайлОбработанных = ОбязательнаяПеременнаяСреды("PROCESSED");
ВыходнойФайл = ОбязательнаяПеременнаяСреды("OUT_FILE");

СтаршиеПоФормату = Новый Соответствие;
Для Каждого ЭлементКлюч Из ПрочитатьJSONФайл(ФайлОбработанных) Цикл
	Если Лев(ЭлементКлюч.Ключ, 1) = "_" Тогда
		Продолжить;
	КонецЕсли;
	Формат = ЭлементКлюч.Значение;
	СтаршиеПоФормату.Вставить(Формат, СтаршаяВерсия(СтаршиеПоФормату.Получить(Формат), ЭлементКлюч.Ключ));
КонецЦикла;

Таблица = Новый ТаблицаЗначений;
Таблица.Колонки.Добавить("Формат");
Таблица.Колонки.Добавить("Версия");
Для Каждого ЭлементКлюч Из СтаршиеПоФормату Цикл
	Строка = Таблица.Добавить();
	Строка.Формат = ЭлементКлюч.Ключ;
	Строка.Версия = ЭлементКлюч.Значение;
КонецЦикла;
Таблица.Сортировать("Формат");

Содержимое = "";
Для Каждого Строка Из Таблица Цикл
	Сообщить("  формат " + Строка.Формат + " -> платформа " + Строка.Версия);
	Содержимое = Содержимое + Строка.Версия + Символы.ПС;
КонецЦикла;
ПолучитьДвоичныеДанныеИзСтроки(Содержимое, "UTF-8", Ложь).Записать(ВыходнойФайл);
Сообщить("Отобрано версий: " + Таблица.Количество());
