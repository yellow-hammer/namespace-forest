// from xdto/uiobjects.xsd
class GaugeChartQualityBand
{
    int begin
    int end
    contains Color backColor
    contains LocalStringMapEntry[] text
    contains LocalStringMapEntry[] tooltip
    String textStr
    String tooltipStr
}

// from xdto/uiobjects.xsd    
class GaugeChartQualityBands
{
    contains GaugeChartQualityBand[] items
    boolean useTextStr
    boolean useTooltipStr
}

class GaugeChartQualityBandsValue extends Value
{
    contains GaugeChartQualityBands[1] value
}

// from chart/chart.xsd   
enum ChartValuesBySeriesConnectionType
{
    None
    EdgesConnection
}

// from chart/chart.xsd   
enum ChartSplineMode
{
    None
    SmoothCurve
}

// from chart/chart.xsd   
enum ChartSemitransparencyMode
{
    DontUse
    Use
    Auto
}

// from mngcore/mngapp.xsd
enum RequiredMobileApplicationPermissions
{
    Multimedia
    Location
    Contacts
    Calendars
    Telephony
    PushNotification
    LocalNotification
    Print
    InAppPurchases
    Ads // since 8.3.10
    BackgroundLocation // since 8.3.11
    BackgroundAudioPlayback // since 8.3.11
    FileExchangeWithPersonalComputer // since 8.3.11
}

// EDBEnums.h
enum TransactionsIsolationLevel
{
    Automatic = 0 ///< автоматический
    ReadUncommitted = 1 ///< чтение незафиксированных
    ReadCommitted = 2 ///< чтение зафиксированных 
    RepeatableRead = 3 ///< повторяемое чтение
    Serializable = 4 ///< упорядочиваемость
}

class ChartLineTypeValue extends Value
{
	ChartLineType value 
}

// from enums/enums.xsd
// since 8.3.13
enum ReportResultViewMode
{
	Auto = 0
	Default = 1
	Compact = 2
}

// from enums/enums.xsd
// since 8.3.14
enum RequiredDataRelevance
{
	Auto = 0
	Relevant = 1
	Any = 2
}

// moved from MoxelContent.xcore due to pictures support in DCS

//
// URL-picture.
//
class UrlPicture extends PictureDef
{
	String url
}

//
// Absolute picture .
//
class AbsPicture extends PictureDef
{
	Byte[] content
}

//
// Picture size mode
//
enum PictureSize
{
    RealSize = 0                                        // Отображение в реальном размере.
    Stretch = 1                                         // Растягивать.
    Proportionally = 2                                  // Растягивать пропорционально.
    Tile = 3                                            // Заполнить.
    AutoSize = 4                                        // Авто.
    //TODO G5V8DT-14777. Не хватает 2 значения, ошибка в базе задач с номером 10063523. 
    //Не забыть добавить новые значения в com._1c.g5.v8.dt.dcs.typedvalue.PictureSizeInfo.getValueText(IV8Project, String, PictureSize)
}

//
// Text position relative to in-cell picture
//
enum CellTextPosition
{
	Auto = 0
	Left = 1
	Right = 2
	Top = 3
	Bottom = 4
	OnTop = 5
}
