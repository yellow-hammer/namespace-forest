@GenModel(nonNLSMarkers="true", prefix="Common", copyrightText="Copyright (C) 2013, 1C", updateClasspath="false",
	featureDelegation="Reflective", rootExtendsClass="com._1c.g5.v8.bm.core.BmObject")
@Ecore(nsPrefix="mdcommon", nsURI="http://g5.1c.ru/v8/dt/metadata/common")
package com._1c.g5.v8.dt.metadata.common

import com._1c.g5.v8.dt.mcore.Color
import com._1c.g5.v8.dt.mcore.Field
import com._1c.g5.v8.dt.mcore.LocalStringMapEntry
import com._1c.g5.v8.dt.mcore.PictureDef
import com._1c.g5.v8.dt.mcore.Value

type Shortcut wraps String

// From syntax-helper (mngcore)
enum ApplicationUsePurpose
{
    PersonalComputer = 0
    MobileDevice = 1
}

// From mngcore/mngapp.xsd
enum ClientRunMode
{
    Auto = 0
    ManagedApplication = 1
    OrdinaryApplication = 2
}

// from enums/enums.xsd (enums)
// Наверное, только в метаданных
enum AutoTimeMode
{
    CurrentOrLast = 0
    DontUse = 1
    Last = 2
    First = 3
    CurrentOrFirst = 4
}

// from enums/enums.xsd (enums)
// Наверное, только в метаданных
enum PostingModeUse
{
    Auto = 0
    Regular = 1
    RealTime = 2
    Ask = 3
}

// from enums/enums.xsd (enums)
// Наверное, только в метаданных
enum AutoShowStateMode
{
    Auto = 0
    DontShow = 1
    Show = 2
    ShowOnComposition = 3
}

// from xdto/core.xsd
// Может использоваться в типах (данных)
// Используется в StandardAttribute, BasicFeature, BasicTabularSection, Constant
enum FillChecking
{
    DontCheck = 0
    ShowError = 1
}

// from enums/enums.xsd
// Наверное, только в метаданных
// Используется в BasicFeature, Constant
enum FoldersAndItemsUse
{
    Items = 0
    Folders = 1
    FoldersAndItems = 2
}

// Может использоваться в типах, но пока используется только в метаданных
// Используется в Catalog, Document, DocumentNumerator и т. п. для обозначения 
// длины кода или номера
// from xdto/core.xsd
enum AllowedLength
{
    Fixed = 0
    Variable = 1
}

// from xdto/core.xsd
enum MainClientApplicationWindowMode
{
    Normal = 0
    Workplace = 1
    FullscreenWorkplace = 2
    Kiosk = 3
}

// From syntax-helper (backend)
enum SearchStringModeOnInputByString
{
    Begin = 0
    AnyPart = 1
}

// From syntax-helper (backend)
enum FullTextSearchOnInputByString
{
    Use = 0
    DontUse = 1
}

// From syntax-helper (backend)
enum ChoiceDataGetModeOnInputByString
{
    Directly = 0
    Background = 1
}

// Группа про Choice Parameter ----------------
abstract class AbstractChoiceParameterLink
{
    String[1] name
    LinkedValueChangeMode changeMode
}

// Наверное, только в метаданных
// Используется в StandardAttribute, BasicFeature, Field, Constant
// From syntax-helper (mngcore)
class ChoiceParameterLink extends AbstractChoiceParameterLink
{
    refers Field[1] field
}

// Используется только в AbstractChoiceParameterLink
// From syntax-helper (enums)
enum LinkedValueChangeMode
{
    Clear = 0
    DontChange = 1
}

// Используется там же, где и ChoiceParameterLink
// From syntax-helper (mngcore)
class ChoiceParameter
{
    String[1] name
    contains Value value
}

// --------------------------------------------
abstract class AbstractTypeLink
{
    int linkItem
}

// Наверное, только в метаданных
// Используется в StandardAttribute, BasicFeature, Constant
// From syntax-helper (mngcore)
class TypeLink extends AbstractTypeLink
{
    refers Field[1] field
}

