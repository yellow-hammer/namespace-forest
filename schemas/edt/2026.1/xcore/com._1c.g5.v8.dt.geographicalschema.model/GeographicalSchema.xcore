	featureDelegation="Reflective", rootExtendsClass="com._1c.g5.v8.bm.core.BmObject", rootExtendsInterface="com._1c.g5.v8.bm.core.IBmObject")
@Ecore(nsPrefix="geographicalSchema", nsURI="http://g5.1c.ru/v8/dt/geographicalschema")
package com._1c.g5.v8.dt.geographicalschema.model

import com._1c.g5.v8.dt.mcore.Uuid
import com._1c.g5.v8.dt.mcore.Picture
import com._1c.g5.v8.dt.mcore.PictureDef
import com._1c.g5.v8.dt.mcore.Color
import com._1c.g5.v8.dt.mcore.Font
