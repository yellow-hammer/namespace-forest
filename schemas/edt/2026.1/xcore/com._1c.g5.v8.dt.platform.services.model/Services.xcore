// Types
type Locale wraps Locale
create
{
    if (it !== null) {
    	val parts = it.split('_')
        if (parts.size == 3)
    		new Locale(parts.get(0), parts.get(1), parts.get(2))
    	else if (parts.size == 2)
    		new Locale(parts.get(0), parts.get(1))
    	else
    		new Locale(it)
    }
}
convert
{
    if (it !== null) it.toString()
}

type Version wraps Version
create
{
	 if (it !== null) new Version(it)
}
convert
{
    if (it !== null) it.toString()
}

type Path wraps Path
create
{
	 if (it !== null) Path.of(it)
}
convert
{
    if (it !== null) it.toString()
}

type URI wraps URI
create
{
     if (it !== null) java.net.URI.create(it)
}
convert
{
    if (it !== null) it.toString()
}

type IProject wraps IProject

/* 1C:Enterprise runtime installation model. */
class RuntimeInstallation
{
	Uuid uuid
	String name
	/*
	 * Platform type identifier.
	 * <p/
	 * @see com._1c.g5.v8.dt.platform.services.core.runtimes.IRuntimeType
	 * @see com._1c.g5.v8.dt.platform.services.core.runtimes.IRuntimeTypeRegistry
	 * @see com._1c.g5.v8.dt.platform.services.core.runtimes.RuntimeInstallations#ENTERPRISE_PLATFORM
	 * @see com._1c.g5.v8.dt.platform.services.mobile.MobileRuntimeInstallations#MOBILE_PLATFORM
	 * @see 'com._1c.g5.v8.dt.platform.services.core.runtimeTypes' extension point.
	 */
	String typeId
	Version version
	int build
	/*
	 * Location of the platform installation.
	 * <p/>
	 * This is not necessarily a local <code>file://</code> location.
	 * For example, for standalone server it could be <code>ssh://host:port//path/to/users-data</code>.
	 * In this case, this runtime installation could be not the real platform installation
	 * but rather a special virtual reference.
	 */
	URI location
	boolean training = "false"
	Arch arch = "Undefined"
	/* Returns the version with build as a {@code String}. */
	op String getVersionWithBuild() {
		return VersionWithBuild.toVersionWithBuild(version, build);
	}
}

/* Architectory type of application installation. */
enum Arch
{
	Undefined
	x86
	x86_64
}

/* The abstract section of 1C:Enterprise infobase references tree model */
abstract class Section
{
	String name
	Uuid uuid
	boolean external = "false"
	double orderInList = "-1"
	double orderInTree
	/* Returns the {@code String} folder of the section. */
	derived String folder get {
		val List<String> folderParts = Lists.newArrayList();
		var EObject parent = eContainer;
		while (parent !== null) {
		    if (!(parent instanceof Section)) {
		        return "/"
		    }
			if (!(parent as Section).name.equals("/")) {
				folderParts.add((parent as Section).name)
			}
			parent = parent.eContainer
			if(parent !== null) folderParts.add("/")
		}
		if (folderParts.isEmpty() || (!folderParts.isEmpty() && !folderParts.get(folderParts.size - 1).equals("/"))) {
			folderParts.add("/")
		}
		val StringBuilder result = new StringBuilder()
		for (String folderPart : Lists.reverse(folderParts)) {
			result.append(folderPart);
		}
		result.toString;
	}
	op boolean validate(EDiagnosticChain diagnostics, EMap<Object, Object> context) {
		SectionValidator::validate(this, diagnostics, context)
	}
}

/* The group of the 1C:Enterprise infobase sections. */
class Group extends Section
{
	contains Section[] subsections
	/* Adds sub-section to this 1C:Enterprise infobase section. */
	op void addSubsection(Section section) {
		if (subsections.contains(section)) {
			val Section otherSection = subsections.get(subsections.indexOf(section));
			if (section.isExternal() != otherSection.isExternal()) {
				val UUID uuid = UUID.randomUUID();
				if (!section.isExternal()) {
					section.setUuid(uuid);
				} else {
					otherSection.setUuid(uuid);
				}
				subsections.add(section);
			}
		} else {
			subsections.add(section);
		}
	}
}

/* The 1C:Enterprise infobase reference. Contains description of the infobase. Actuial infobase may or may not exist. */
class InfobaseReference extends Section
{
	contains IConnectionString connectionString
	UseProxy useProxy
	String proxyServer
	Integer proxyPort
	String proxyUser
	String proxyPassword
	ClientConnectionSpeed clientConnectionSpeed
	Authentication authentication
	Authentication webserverAuthentication
	ClientType clientType
	AppArch appArch
	ClientType defaultClientType
	/*
	 * Platform version to be used to interact with the infobase.
	 * <p/>
     * Could be a mask, a full version, null if no preference was specified or some garbage as specified by user.
	 */
	String version
	String defaultVersion
	String webCommonInfoBaseUrl
	String additionalParameters
	/*
	 * Address to connect to via designer agent protocol in case of web infobase reference
	 * representing standalone server or cloud infobase.
	 * <p/>
	 * Usually has the following form: <code>ssh://host:port//path/to/users-data</code>
	 */
	String developmentServer // since 8.3.20

	// HTTPS keys
	CertificateSourceType httpsCaCertificate
	CertificateSourceType httpsClientCertificate
	String httpsClientCertificateFile
	CertificateSelectType httpsClientCertificateSelectType
	String httpsClientNssPath
	String httpsClientNssCertificateName
	String httpsCaCertificateFile

	// mobile client keys
	boolean showInList
	String updateUrl
	String mobilePublicKey

	/* Returns a type of the infobase for this infobase reference. */
	derived InfobaseType infobaseType get {
		if (connectionString instanceof FileConnectionString)
			InfobaseType.FILE
		else if (connectionString instanceof ServerConnectionString)
			InfobaseType.SERVER
		else if (connectionString instanceof WebServerConnectionString)
			InfobaseType.WEB
	}

	/* Validates the infobase reference. */
	op boolean validate(EDiagnosticChain diagnostics, EMap<Object, Object> context) {
		InfobaseReferenceValidator::validate(this, diagnostics, context)
	}
}

interface IConnectionString
{
	op String asConnectionString()
	op String asCommandOption()
	op String getCommandParameter()
}

class FileConnectionString extends IConnectionString
{
	String file // path as string
	op String asConnectionString() {
		"File=\"" + Strings.nullToEmpty(file) + "\";"
	}
	op String asCommandOption() {
		Strings.nullToEmpty(file);
	}
	op String getCommandParameter() {
		return "F";
	}
}

class ServerConnectionString extends IConnectionString
{
	String server
	String reference
	op String asConnectionString() {
		"Srvr=\"" + Strings.nullToEmpty(server) + "\";Ref=\"" + Strings.nullToEmpty(reference) + "\";"
	}
	op String asCommandOption() {
		Strings.nullToEmpty(server) + "\\" + Strings.nullToEmpty(reference);
	}
	op String getCommandParameter() {
		return "S";
	}
}

class WebServerConnectionString extends IConnectionString
{
	String url
	op String asConnectionString() {
		"ws=\"" + Strings.nullToEmpty(url) + "\";"
	}
	op String asCommandOption() {
		Strings.nullToEmpty(url);
	}
	op String getCommandParameter() {
		return "WS";
	}
}

