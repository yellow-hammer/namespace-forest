// Web servers model
class WebServer
{
	String name
	String typeId // see 'com._1c.g5.v8.dt.platform.services.core.webServerTypes' extension point
	Path installLocation
	Path configLocation
	Arch arch = "Undefined"
}

abstract class Publication
{
	String[1] name // equals to Alias
	String[1] location // path as string
	refers transient WebServer webServer
	derived PublicationType PublicationType get {
		if (this instanceof InfobasePublication)
			PublicationType.INFOBASE
		else if (this instanceof MobileApplicationPublication)
			PublicationType.MOBILE_APPLICATION
		else
			throw new IllegalStateException("Unsupported type of Publication")
	}
}

class InfobasePublication extends Publication
{
	String[1] infobaseConnection
	String tempLocation // path as string

	boolean enable = "true"
	JobExecution executeScheduledJobs = "On"
	boolean enableStandardOData = "true"
	String progressiveWebApplication // since 8.3.18
	boolean enableSystemAnalytics // since 8.3.18

	String exitUrl

	String distributiveWin32
	String distributiveWin64
	String distributiveLinuxDeb32 // since 8.3.18
	String distributiveLinuxDeb64 // since 8.3.18
	String distributiveLinuxRpm32 // since 8.3.18
	String distributiveLinuxRpm64 // since 8.3.18
	String distributiveMac64

	contains Pool pool
	contains Debug debug
	contains OpenId openId
	contains OpenIdConnect openIdConnect
	contains OData standardOdata
	contains WebServices webServices
	contains HttpServices httpServices
	contains DataSeparator[] dataSeparators
}

class MobileApplicationPublication extends Publication
{
	boolean publishRunConfiguration
	String[1] debugUrl
	derived boolean debugEnabled get {
		debugUrl !== null
	}
}

enum PublicationType
{
	Infobase
	MobileApplication
}

