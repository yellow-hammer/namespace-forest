class HippoGeneratorContext
{	
    //TODO ILogFormEditHelper pHelper
    int alias
    String lang = ""
    // TODO pMobileInfoProvider - support mobile in G5V8DT-8638
    LFTargetPlatform targetPlatform
    ClientInterfaceVariant interfaceVariant
    ILogFormAdditionalInfoProvider pProvider
    refers MainElementGeneratorContext pHippoGeneratorMainElement
    boolean mobilePlatform
    refers MobileTransformations mobileTransformations

    contains LongHippoLayTableMapEntry[] tables
    contains LongFormVisualMapEntry[] logFormIndexById
    contains StringFormVisualMapEntry[] logFormIndexByName
    refers SearchButtonTransformations searchButtonTransformations // since 8.3.16
}

class LongHippoLayTableMapEntry wraps Map$Entry
{
	Long key
	refers HippoLayTable value
}

class LongFormVisualMapEntry wraps Map$Entry
{
	Long key
	refers FormVisualEntity value
}

class StringFormVisualMapEntry wraps Map$Entry
{
	String key
	refers FormVisualEntity value
}

// mngbase\IHippoGenerator.h
class MobileTransformations
{
    boolean searchDefaultButton = "false"
    refers Button pDefaultButton
    boolean generateCloseButton = "false"
    refers Button pCloseButton // Кнопка с левом углу заголовка.
    boolean searchTopCommandBar = "false"
    refers FormGroup pTopCommandBar
}

// mngbase\IHippoGenerator.h
class SearchButtonTransformations // since 8.3.16
{
    // флаг необходимости обрабатывать команлды поиска
    boolean useTransformations = "false"
    // список таблиц с расширениями поиска
    Long[] tablesWithSearchAdditions
    // список идентификаторов таблиц со специальной обработкой команд
    Long[] tablesWithApppropriatePropertyType
    // перечень команд поиска которые надо убрать
    //TODO: std::vector<IHippoGeneratorElement*> doubtfulButtons;
}

