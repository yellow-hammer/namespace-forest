class MainElementGeneratorContext extends ElementWithAutoCommandBarBaseGeneratorContext, GroupBaseGeneratorContext
{
    boolean generateIntermediateMainLayouter
    GenerateIntermediateMainLayouter generateIntermediateMainLayouterMode
    String title = ""
    FormItemSpacing horSpacing
    FormItemSpacing verSpacing
    FormChildrenAlign childrenAlign
    ItemHorizontalAlignment horAlgn
    ItemVerticalAlignment verAlgn
    refers ElementBaseGeneratorContext pIntermediateMainLayouter
