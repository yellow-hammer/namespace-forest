}

abstract class ACastingType
{
}

class CastingBooleanType extends ACastingType
{
}

class CastingNumberType extends ACastingType
{
	contains AbstractExpression length
	contains AbstractExpression precision
}

class CastingStringType extends ACastingType
{
	contains AbstractExpression length
}

class CastingDateType extends ACastingType
{
}

class CastingTableType extends ACastingType
{
