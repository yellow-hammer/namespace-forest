//индексированное содержимое - это возможность по хранящемуся элементу получить его индекс в контейнере


//СхемаЗапроса
class QuerySchema
{
	contains AbstractQuerySchemaQuery[] queries
}

abstract class AbstractQuerySchemaDbView
{
}

//DbView generated by select query
class DbViewFromQuery extends DbViewDef, AbstractQuerySchemaDbView
{
	refers transient DbViewDef originalDbView
	op DbViewFieldDef[] getActualFields()
	{
		if ((this.fields === null || this.fields.empty) && originalDbView !==  null)
		{
			return originalDbView.fields
		}
		else
		{
			return this.fields
		}
	}
}

class DbViewNestedTableFromQuery extends DbViewFieldFieldDef, DbViewFromQuery
{
	
}

//в секции "from" может быть задана таблица при помощи ParameterExpression
//мы не можем знать поля для такого источника, а значит не можем валидировать его,
//поэтому будем выделять их как warnings
class DbViewOuterParamTable extends DbViewDescriptionTempTable
{
	
}

class DbViewDescriptionTempTable extends DbViewDef, AbstractQuerySchemaDbView
{
	
}

class DbViewFieldFieldDefFromQuery extends DbViewFieldFieldDef, AbstractQuerySchemaDbView
{
	
}

//неопознанный DbView
class UnresolvedDbView extends DbViewDef, AbstractQuerySchemaDbView
{
	
}

//АбстрактныйЗапросСхемыЗапроса
abstract class AbstractQuerySchemaQuery
{
	//общий интерфейс для всех типов запросов
}

//общий класс для всех таблиц
abstract class AbstractQuerySchemaTable
{
	String tableName
	refers transient DbViewElement tableDbView
	refers DbViewElement computeDbView
	
	op String getFullTableName()
}

class SinglePartQuerySchemaTable extends AbstractQuerySchemaTable
{
	op String getFullTableName()
	{
		return tableName
	}
}

class MultiPartQuerySchemaTable extends AbstractQuerySchemaTable
{
	contains AbstractQuerySchemaTable parentTable
	
	op String getFullTableName()
	{
		var notNullContent = ""
		if (tableName !== null)
		{
			notNullContent = tableName
		}
		val builder = new StringBuilder(notNullContent)
		var AbstractQuerySchemaTable currentParentTable = parentTable
		while (currentParentTable !== null)
		{
			builder.insert(0, ".")
			builder.insert(0, currentParentTable.getTableName())
			if (currentParentTable instanceof MultiPartQuerySchemaTable)
			{
				currentParentTable = currentParentTable.parentTable
			}
			else
			{
				currentParentTable = null
			}
		}
		return builder.toString()
	}
}

//общий класс для Представления
abstract class AbstractQuerySchemaPresentation
{
	String presentation
}

//ЗапросУничтоженияТаблицыСхемыЗапроса
class QuerySchemaDropTableQuery extends AbstractQuerySchemaQuery
{
	contains AbstractQuerySchemaTable table
}

//ЗапросВыбораСхемыЗапроса
class QuerySchemaSelectQuery extends AbstractQuerySchemaQuery
{
	contains transient DbViewFromQuery dbViewByThis
	boolean autoOrder //"автоупорядочивание" - может как быть, так и не быть задана (по умолчанию = false)
	boolean commonTotals //"общие итоги", могут и не присутствовать в запросе
	contains QuerySchemaOrderExpression[] orderExpressions //"упорядочить по", моожет и не присутствавать в запросе
	contains QuerySchemaOperator[] operators //"выбрать"
	contains QuerySchemaExpression[] indexes //"индексировать по", моожет и не присутствовать в запросе
	contains QuerySchemaExpression[] totalExpressions //"итоги", могут и не присутствавать в запросе // ?????????????????????
	contains QuerySchemaTotalControlPoint[] totalControlPoints //"итоги по", могут и не присутствавать в запросе
	
	//возвращает таблицу помещения запроса ("ПОМЕСТИТЬ ...")
	op AbstractQuerySchemaTable getPlacementTable()
	{
		if (operators !== null && !operators.empty)
		{
			return operators.get(0).placementTable
		}
		return null;
	}
}

//ВыражениеПорядкаСхемыЗапроса
class QuerySchemaOrderExpression
{
	boolean desc
	boolean hierarchy
	contains QuerySchemaExpression item //тут может быть псевдоним
	derived QuerySchemaOrderDirection direction get
	{
		if (hierarchy)
		{
			if (desc)
			{
				return QuerySchemaOrderDirection.HIERARCHY_DESCENDING
			}
			else
			{
				return QuerySchemaOrderDirection.HIERARCHY_ASCENDING
			}
		}
		else if (desc)
		{
			return QuerySchemaOrderDirection.DESCENDING
		}
		return QuerySchemaOrderDirection.ASCENDING
	}
}

//НаправлениеПорядкаСхемыЗапроса
enum QuerySchemaOrderDirection
{
	Ascending
	HierarchyAscending
	Descending
	HierarchyDescending
}

//ОператорВыбратьСхемыЗапроса
class QuerySchemaOperator
{
	contains transient DbViewDef[] dbViewByFrom
	contains transient DbViewDef[] dbViewByFields
	contains transient DbViewDescriptionTempTable[] descriptionTempTable 
	
	boolean flagUnionType
	boolean flagUnionTypeAll
	
	derived QuerySchemaUnionType unionType get //игнорируется для первой части запроса
	{
		if (flagUnionTypeAll)
		{
			return QuerySchemaUnionType.UNION_ALL	
		}
		return QuerySchemaUnionType.UNION
	}
	contains AbstractQuerySchemaTable placementTable //исходя из модели, данное поле не должно располагаться тут, 
												     //но грамматически это не получилось сделать
	contains QuerySchemaExpression[] grouping // "Сгруппировать по"
	String getRecordsCount // КоличествоПолучаемыхЗаписей (число или null) // "Первые n"
	boolean selectDistinct //"Выбрать Различные"
	boolean selectForUpdate //выбирать для изменения //если в тексте запроса есть слово "Для изменения"
	boolean selectAllowed //"разрешенные" может быть только у главного запроса
	contains QuerySchemaExpression filters //отбор //"Где"
	contains QuerySchemaExpression havingExpression //"имеющие", может и не присутствовать в запросе
	contains QuerySchemaTableForUpdate[] tablesForUpdate //таблицы для изменения // "Для Изменения"
	contains QuerySchemaSource[] sources //источники схемы запросов
	contains QuerySchemaExpression[] selectFields //ВыбираемыеПоля, то что идет после слова выбрать. Важно, на данном этапе все зависит от слова "объединить",
														  //что из них станет колонками
}

//ТаблицаДляИзмененияСхемыЗапроса
class QuerySchemaTableForUpdate
{
	contains AbstractQuerySchemaTable table
}


type CheckerExpression wraps IExpressionTypeChecker
//ВыражениеСхемыЗапроса
class QuerySchemaExpression
{
	transient boolean computeAlias
	String alias
	contains AbstractExpression expression
	
	op TypeDescription getType(CheckerExpression checker)
	{
		val TypeDescription ^type = checker.checkType(expression, false).expressionTypeResult
		return ^type
	}
	
	op boolean isAggregateFunction()
	{
		//TODO
		if (expression instanceof FunctionExpression)
		{
			return true;
		}
		return false
	}
}

//ТипОбъединенияСхемыЗапроса
enum QuerySchemaUnionType
{
	Union
	UnionAll
}

//ИсточникСхемыЗапроса
class QuerySchemaSource
{
	contains AbstractQuerySchemaSource source
	contains AbstractQuerySchemaQuerySourceJoin[] joins  	
}

//АбстрактныйИсточникСхемыЗапроса
abstract class AbstractQuerySchemaSource
{
	transient boolean computeAlias
	String alias
}

abstract class AbstractQuerySchemaQuerySourceJoin
{
}

//СоединениеИсточникаЗапросаСхемыЗапроса
class QuerySchemaQuerySourceJoin extends AbstractQuerySchemaQuerySourceJoin
{
	QuerySchemaJoinType joinType
	contains QuerySchemaExpression condition
	contains QuerySchemaSource source 
}

//ТипСоединенияСхемыЗапроса
enum QuerySchemaJoinType
{
	Inner
	LeftOuter
	FullOuter
	RightOuter
}

//ВложенныйЗапросСхемыЗапроса
class QuerySchemaNestedQuery extends AbstractQuerySchemaSource
{
	contains QuerySchemaSelectQuery query
}

//ТаблицаСхемыЗапроса
class QuerySchemaTable extends AbstractQuerySchemaSource
{
	contains AbstractQuerySchemaTable table
	contains QuerySchemaTableParameter[] parameters 
}

//ПараметрТаблицыСхемыЗапроса
class QuerySchemaTableParameter
{
	contains QuerySchemaExpression expression
	contains QuerySchemaExpression[] expressionDcs
}

//ОписаниеВременнойТаблицыСхемыЗапроса
class QuerySchemaTempTableDescription extends AbstractQuerySchemaSource
{	
	contains ParameterExpression table
}

class QuerySchemaTotalControlPoint
{
	boolean only
	boolean hierarchy
	boolean periods
	contains QuerySchemaExpression expression //псевдоним тут не заполняется
	derived QuerySchemaControlPointType controlPointType get
	{
		if (hierarchy)
		{
			if (only)
			{
				return QuerySchemaControlPointType.HIERARCHY_ONLY
			}
			else
			{
				return QuerySchemaControlPointType.HIERARCHY
			}
		}
		return QuerySchemaControlPointType.ITEMS
	}
	transient boolean computeColumnName
	String columnName
	QuerySchemaPeriodAdditionType periodAdditionType
	contains QuerySchemaExpression periodAdditionBegin //(or null)
	contains QuerySchemaExpression periodAdditionEnd //(or null)
}

//ТипКонтрольнойТочки
enum QuerySchemaControlPointType
{
	Items
	Hierarchy
	HierarchyOnly
}

//ТипДополненияПериодамиСхемыЗапроса
enum QuerySchemaPeriodAdditionType
{
	WithoutAdditions //БезДополнения
	Year
	TenDays //Декада
	Day
	Quarter //Квартал
	Month
	Minute
	Week
	HalfYear
	Second
	Hour
}

//самый общий класс для всех выражений доступных в языке
abstract class AbstractExpression
{
}

//константные выражения языка
abstract class ALiteralsExpression extends AbstractExpression
{
}

//операторы
abstract class AOperatorsExpression extends AbstractExpression
{
}

abstract class AUnaryOperatorsExpression extends AOperatorsExpression
{
	contains AbstractExpression expression
}

abstract class ABinaryOperatorsExpression extends AOperatorsExpression
{
	contains AbstractExpression left
	contains AbstractExpression right
}

//функции
class FunctionInvocationExpression extends AbstractExpression
{
	refers FunctionExpression functionType
	contains AbstractExpression[] params
	boolean distinct
}

type AdditionalExpressionChecker wraps IAdditionalExpressionChecker

class FunctionExpression extends AbstractExpression, DuallyNamedElement
{
	boolean distinct
	boolean aggregate
	int minNumParams
	int maxNumParams
	String[] allowedPeriodType //имеет смысл только для функций работы с датой
	refers TypeDescription returnType
	refers TypeDescription[] paramTypes
	AdditionalExpressionChecker additionalParam
}

class DerivedFunctionExpression extends FunctionExpression
{
	refers EObject source
}

