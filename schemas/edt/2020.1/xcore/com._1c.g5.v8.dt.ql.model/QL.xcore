}

class UndefinedLiteralExpression extends ALiteralsExpression
{    
}

class NullLiteralExpression extends ALiteralsExpression
{  
}

//данный литерал всегда получает на вход выражение состоящие как минимум из двух частей разделенных точками
class ValueLiteralExpression extends ALiteralsExpression
{
