abstract class ACommonUnaryOperatorExpression extends AUnaryOperatorsExpression
{
}

abstract class ACommonBinaryOperatorExpression extends ABinaryOperatorsExpression
{
}

//арифметические операторы
class CommonUnaryNegOperatorExpression extends ACommonUnaryOperatorExpression
