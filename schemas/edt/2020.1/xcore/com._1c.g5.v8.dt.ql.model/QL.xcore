}

enum LogicalCompareType
{
	Less // <
	Equal // =
	More // >
	LessEqual // <=
	MoreEqual // >=
	NotEqual // <>
}

//"ЕСТЬ NULL"
class IsNullOperatorExpression extends ALogicalUnaryOperatorExpression
{
	boolean isNot //"ЕСТЬ НЕ NULL"
}

class VerbalOperatorExpression extends ALogicalBinaryOperatorExpression
{
	VerbalOperatorType ^type
	boolean not
}

enum VerbalOperatorType
{
	Like
	In
	Between
	Refs
}

class LikeExpression extends AbstractExpression
{
	contains AbstractExpression literal
	contains AbstractExpression escape
}

class InExpression extends AbstractExpression
{
	boolean hierarchy
	contains AbstractExpression[] expression
