{
}

abstract class ALogicalBinaryOperatorExpression extends ABinaryOperatorsExpression
{
}

class LogicalANDOperatorExpression extends ALogicalBinaryOperatorExpression
{
}

class LogicalOROperatorExpression extends ALogicalBinaryOperatorExpression
{
}

class LogicalNOTOperatorExpression extends ALogicalUnaryOperatorExpression
{
}

class LogicalCompareOperatorExpression extends ALogicalBinaryOperatorExpression
{
