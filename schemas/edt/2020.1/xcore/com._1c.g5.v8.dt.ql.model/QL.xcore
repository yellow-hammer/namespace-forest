//эти те выражения, которые не являются ни литералами, ни операторами, ни функциями
abstract class ACommonExpression extends AbstractExpression
{
}

abstract class CommonExpression extends ACommonExpression
{
	String content
	refers transient DbViewElement itemDbView
	refers DbViewElement computeDbView
	
	op String getFullContent()
}

//здесь общие выражения, состоящие из одного слова
class SinglePartCommonExpression extends CommonExpression
{	
	op String getFullContent()
	{
		return content
	}
}

//здесь общие выражения, состоящие из нескольких слова
class MultiPartCommonExpression extends CommonExpression
{	
	contains CommonExpression sourceTable
	
	op String getFullContent()
	{
		var notNullContent = ""
		if (content !== null)
		{
			notNullContent = content
		}
		val builder = new StringBuilder(notNullContent)
		var CommonExpression currentSourceTable = sourceTable
		while (currentSourceTable !== null)
		{
			builder.insert(0, ".")
			builder.insert(0, currentSourceTable.getContent())
			if (currentSourceTable instanceof MultiPartCommonExpression)
			{
				currentSourceTable = currentSourceTable.sourceTable
			}
			else
			{
				currentSourceTable = null
			}
		}
		return builder.toString()
	}
}

//тут же и содержится выражение "ПУСТАЯТАБЛИЦА"
class NestedTableExpression extends ACommonExpression
{
	contains CommonExpression table
	contains QuerySchemaExpression[] fieldsName
}

//tableName.*
class NestedTableAllFieldsExpression extends ACommonExpression
{
	contains CommonExpression table
}

class FieldWithCasting extends AbstractExpression
{
	contains ACommonExpression table
	contains CastOperationExpression castOperation
	boolean allFields
	refers transient DbViewElement itemDbView
}

class StarExpression extends AbstractExpression
{
	
}

class EmptyExpression extends AbstractExpression
{
	
}

class CompoundExpression extends AbstractExpression
{
    contains AbstractExpression head
    contains AbstractExpression[] tail
}

class BracketCommonExpression extends AbstractExpression
{
	contains AbstractExpression bracketPart
	contains ACommonExpression commonExpression
	boolean allFields
}
