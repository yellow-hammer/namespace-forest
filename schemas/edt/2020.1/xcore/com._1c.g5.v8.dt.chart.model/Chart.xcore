@GenModel(loadInitialization="false", nonNLSMarkers="true", prefix="Chart", copyrightText="Copyright (C) 2015, 1C", literalsInterface="true", updateClasspath="false", featureDelegation="Reflective", rootExtendsClass="com._1c.g5.v8.bm.core.BmObject", rootExtendsInterface="com._1c.g5.v8.bm.core.IBmObject")
@Ecore(nsPrefix="chart", nsURI="http://g5.1c.ru/v8/dt/chart/model")
package com._1c.g5.v8.dt.chart.model

import com._1c.g5.v8.dt.mcore.AbstractLine
import com._1c.g5.v8.dt.mcore.Border
import com._1c.g5.v8.dt.mcore.Color
import com._1c.g5.v8.dt.mcore.Font
import com._1c.g5.v8.dt.mcore.LocalStringMapEntry
import com._1c.g5.v8.dt.mcore.Point
import com._1c.g5.v8.dt.mcore.Uuid
import com._1c.g5.v8.dt.mcore.Value
import com._1c.g5.v8.dt.metadata.common.ChartLineType
import com._1c.g5.v8.dt.metadata.common.HorizontalAlign

enum ChartType
{
    Line as "Line" = 0, // График.
    Step as "Step" = 1, // График по шагам.
    Area as "Area" = 2, // График с областями.
    AreaAdd as "StackedArea" = 3,      // График с областями и накоплением.
    HistSimple as "Column" = 4,   // Гистограмма.
    HistMultiStage as "StackedColumn" = 5,       // Гистограмма с накоплением.
    Hist3D as "Column3D" = 6,       // Гистограмма объемная.
    Hist3DMultiStage as "StackedColumn3D" = 7,     // Гистограмма с накоплением объемная.
    HorHistSimple as "Bar" = 8,// Гистограмма горизонтальная.
    HorHistMultiStage as "StackedBar" = 9,    // Гистограмма с накоплением горизонтальная.
    HorHist3D as "Bar3D" = 10,   // Гистограмма горизонтальная объемная.
    HorHist3DMultiStage as "StackedBar3D" = 11, // Гистограмма с накоплением горизонтальная объемная. 
    Circle as "Pie" = 12,      // Круговая.
    Circle3D as "Pie3D" = 13,    // Круговая объемная.
    Stock as "Stock" = 14,       // Биржевая
    StockEx as "OpenHighLowClose" = 15,     // Биржевая "свеча"
    IsometricStd as "BarGraph" = 16,// Изометрическая обычная.
    IsometricCeil as "CeilGraph" = 17,       // Изометрическая непрерывная.
    IsometricTape as "TapeGraph" = 18,       // Изометрическая лента.
    IsometricPyramid as "PyramidGraph" = 19,    // Изометрическая пирамида. 
    Waterfall as "Waterfall" = 20,   // Водопад.
    Wireframe as "WireframeSurface" = 21,   // Каркасная поверхность.
    Surface as "Surface" = 22,     // Поверхность.
    ConvexSurface as "ConvexSurface" = 23,       // Выпуклая поверхность.
    ConcaveSurface as "ConcaveSurface" = 24,      // Вогнутая поверхность.
    ShadedSurface as "ShadedSurface" = 25,      // Затененная поверхность.
    LineAdd as "StackedLine" = 26,     // График с накоплением.
    AreaNorm as "NormalizedArea" = 27,    // График с областями нормированный.
    HistSimpleNorm as "NormalizedColumn" = 28,      // Гистограмма нормированная.
    Hist3DNorm as "NormalizedColumn3D" = 29,  // Гистограмма нормированная объемная. 
    HorHistSimpleNorm as "NormalizedBar" = 30,   // Гистограмма нормированная горизонтальная.
    HorHist3DNorm as "NormalizedBar3D" = 31,       // Гистограмма нормированная горизонтальная объемная. 
    Honeycomb as "Honeycomb" = 32,   // Сотовая.
    RadarLine as "RadarLine" = 33,   // Радарный график.
    RadarArea as "RadarArea" = 34,   // Радарный график с областями.
    RadarLineAdd as "RadarStackedLine" = 35,// Радарный график с накоплением.
    RadarAreaAdd as "RadarStackedArea" = 36,// Радарный график с областями и накоплением.
    RadarAreaNorm as "RadarNormalizedArea" = 37,       // Радарный график с областями нормированный.
    Gauge as "Gauge" = 38,       // Измерительная диаграмма.
    Funnel as "Funnel" = 39,      // Воронка
    Funnel3D as "Funnel3D" = 40,    // Воронка 3D
    FunnelNorm as "NormalizedFunnel" = 41,  // Воронка нормированного вида
    FunnelNorm3D as "NormalizedFunnel3D" = 42 // Воронка нормированного вида 3D
    Scatter as "Scatter" = 43,     // Точечная диаграмма
    Bubble as "Bubble" = 44       // Пузырьковая
}

// Виды подписей к круговой диаграмме.
enum ChartLabelType  //   CircleLabelType in cpp
{
    None = 0,                    // Нет.
    Series = 1,                  // Имя серии.
    Value = 2,                   // Значение.
    Percent = 3,                 // Процент. 
    SeriesPercent = 4,           // Имя серии + процент.
    SeriesValue = 5,             // Имя серии + значение. 
    SeriesValuePercent = 6,      // Имя серии + значение + процент.
    ValuePercent = 7,            // Значение + процент.
    Point = 8,                   // Имя точки. 
    PointPercent = 9,            // Имя точки + процент.
    PointValue = 10,             // Имя точки + значение.
    PointValuePercent = 11,      // Имя точки + значение + процент.
    SeriesPoint = 12,            // Имя серии + имя точки.
    SeriesPointPercent = 13,     // Имя серии + имя точки + процент.
    SeriesPointValue = 14,       // Имя серии + имя точки + значение. 
    SeriesPointValuePercent = 15 // Имя серии + имя точки + значение + процент.
    ValueSize = 16,              // Значение + размер
    SeriesSize = 17,             // Имя серии + размер
    SeriesValueSize = 18,        // Имя серии + значение + размер
    SeriesPointSize = 19,        // Имя серии + имя точки + размер
    SeriesPointValueSize = 20,   // Имя серии + имя точки + значение + размер
    PointSize = 21,              // Имя точки + размер
    PointValueSize = 22          // Имя точки + значение + размер
}

// Расположение подписей
enum ChartLabelLocation    // ChartLabelsLocation in cpp
{
    Edge = 0,       // eCLLEdge
    Center = 1,     // eCLLCenter
    EdgeInside = 2, // eCLLEdgeInside
    EdgeAuto = 3,    // eCLLEdgeAuto
    Auto = 4,        // eCLLAuto since 8.3.10  
    TopLeft = 5,     // eCLLTopLeft since 8.3.10 // since 8.3.11 name is "LeftTop"
    BottomLeft = 6,  // eCLLBottomLeft since 8.3.10 // since 8.3.11 name is "LeftBottom"
    TopRight = 7,    // eCLLTopRight since 8.3.10 // since 8.3.11 name is "RightTop"
    BottomRight = 6, // eCLLBottomRight since 8.3.10 // since 8.3.11 name is "RightBottom"
    TopAndLeftSpecified = 9, // eCLLCoords since 8.3.10 // since 8.3.11 name is "LeftAndTopSpecified"
    EmptySpace = 10  // eCLLFreePlace since 8.3.10
}

// Режим выдвижения секторов круговых диаграмм.
