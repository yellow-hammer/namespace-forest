//            <xs:enumeration value="Maximum" />
//            <xs:enumeration value="Minimum" />
//        </xs:restriction>
//    </xs:simpleType>
enum CircleExpandMode
{
    ExpandNone as "None" = 0, // Внешнее управление.
    ExpandAll as "All" = 1,  // Выдвигать всё.
    ExpandMax as "Maximum" = 2,  // Выдвигать максимальную серию.
    ExpandMin as "Minimum" =  3  // Выдвигать минимальную серию.
}

