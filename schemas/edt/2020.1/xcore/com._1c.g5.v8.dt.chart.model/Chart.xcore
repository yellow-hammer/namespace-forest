{
    Horizontal = 0, //       eLOHorizontal = 0, // Горизонтальная.
    Vertical = 1,   //       eLOVertical,       // Вертикальная. 
    Auto = 2        //       eLOAuto            // Авто.
    CustomAngle = 3 //       eLOCustomAngle     // Произвольный угол.
}

