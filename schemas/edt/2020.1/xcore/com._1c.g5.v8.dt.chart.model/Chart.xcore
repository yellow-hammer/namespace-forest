{
    SpaceNone as "None" = 0,   //         eSpaceNone = 0, // Нет.
    SpaceHalf as "Half" = 1,   //         eSpaceHalf = 1, // Половина.
    SpaceFull as "Full" = 2    //         eSpaceFull = 2  // Полный.
}

// Вид палитры.
//    <xs:simpleType name="ChartColorPalette">
//      <xs:restriction base="xs:string">
//        <xs:enumeration value="Palette8" />
