enum MaxSeriesMode
{
    UndefinedMode as "NotDefined" = 0,  //        eUndefinedMode = 0, // Не ограничено.
    DefinedMode as "Limited" = 1,       //        eDefinedMode = 1,   // Жестко задано.
    PercentMode as "Percent" = 2        //        ePercentMode = 2    // Задано как процент.
}

