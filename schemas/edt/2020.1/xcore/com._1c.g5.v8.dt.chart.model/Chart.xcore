enum GaugeChartLabelsLocation
{
    OnScale as "AtScale" = 0,    // eOnScale,
    InsideScale as "InsideScale" = 1 // eInsideScale
}

// Сплайновый режим "сглаживания"
//    <simpleType name="ChartSplineMode">
//      <restriction base="string">
//        <enumeration value="None" />
//        <enumeration value="SmoothCurve" />
//      </restriction>
//    </simpleType>
enum EnSplineMode
{
    SplineNone as "None" = 0 ,  //  eSplineNone  = 0, // Сглаживание не применяется
    SplineBound as "SmoothCurve" = 1   // eSplineBound = 1  // Гладкое соединение точек
}


// Режим прозрачности
//    <simpleType name="ChartSemitransparencyMode">
//      <restriction base="string">
//        <enumeration value="DontUse" />
//        <enumeration value="Use" />
//        <enumeration value="Auto" />
//      </restriction>
//    </simpleType>
enum EnTranslucenceMode
{
    None as "DontUse" = 0,    // eTranslucenceNone   = 0, // Прозрачность не используется
    Custom as "Use" = 1,  // eTranslucenceCustom = 1, // ...настраивается пользователем
    Auto as "Auto" = 2     // eTranslucenceAuto   = 2  // ...настраивается автоматически
}

// Режим соединения серий в гистограммах с накоплением
//  <simpleType name="ChartValuesBySeriesConnectionType">
//      <restriction base="string">
//        <enumeration value="None" />
//        <enumeration value="EdgesConnection" />
//      </restriction>
//    </simpleType>
enum EnMultiStageLinkMode
{
    MultiStageLinkNone as "None" = 0,   // eMultiStageLinkNone = 0, // Соединения отсутвствуют
    MultiStageLinkEdge as "EdgesConnection" = 1    // eMultiStageLinkEdge = 1  // Соединения между краями баров одной серии
}


// Анимация диаграммы.
//    <simpleType name="ChartAnimation">
//        <restriction base="string">
//            <enumeration value="Auto" />
//            <enumeration value="Use" />
//            <enumeration value="DontUse" />
//        </restriction>
//    </simpleType>
enum ChartAnimation
{
   Auto = 0,     //  eAuto = 0,     // В зависимости от глобальных настроек
   Use = 1,      // eUse,          // Использовать.
   DontUse = 2   // eDontUse       // Не использовать
}

// Виды маркера.
//    <simpleType name="ChartMarkerType">
//        <restriction base="string">
//            <enumeration value="None" />
//            <enumeration value="Rect" />
//            <enumeration value="Circle" />
//            <enumeration value="Rhomb" />
//        </restriction>
//    </simpleType>
enum MarkerType
{
    None = 0,    // eMrkNone = 0,   // Нет.
    Rect = 1,    // eMrkRect = 1,   // Квадрат.
    Circle = 2,  // eMrkCircle = 2, // Круг.
    Rhomb = 3,    // eMrkRhomb = 3   // Ромб.
    Auto = 4,     // eMrkAuto since 8.3.10 // Авто
    Alternation = 5, // eMrkNext since 8.3.10 // Брать следующий
    GradientCircle = 6, // eMrkGradientCircle since 8.3.10 // Градиентный шар, только для пузырьковой диагарммы, во встроенном языке не нужен
    AlphaGradientCircle = 7 // eMrkAlphaGradientCircle since 8.3.10 // Градиентный шар c альфа-каналом, только для пузырьковой диагарммы, во встроенном языке не нужен
}

class ChartLine extends AbstractLine
{
    ChartLineType style
}

class DoubleRect
{
	double left
	double right
	double top
	double bottom
}

//Тип аппроксимации линии тренда
//since 8.3.10
enum TrendlineApproximationType
{
	Linear = 0,
	Exponential = 1,
	Logarithmic = 2,
	Power = 3,
	Polynomial = 4
}

//Фактор линии тренда диаграммы
//since 8.3.10
enum TrendlineFactor
{
	Auto = 0,
	PointNumber = 1,
	PointValue = 2
}

//Используемое значение точки биржевой диаграммы
//since 8.3.10
enum StockChartUsedPointValue
{
	Open as "Open" = 0,
	Max as "High" = 1,
	Min as "Low" = 2,
	Close as "Close" = 3,
	OpenCloseAverage as "OpenCloseAverage" = 4
}

//Режим отображения серии в легенде
//since 8.3.10
enum ShowInChartLegend
{
	Auto = 0,
	Show = 1,
	DontShow = 2
}

//Режим отображения серии при отрисовке диаграммы
//since 8.3.10
enum ShowOnChart //since 8.3.11 name of the enum is "ShowInChart"
{
	Auto = 0,
	Show = 1,
	DontShow = 2
}

//Порядок отображения серий в легенде диаграммы
//since 8.3.10
enum SeriesOrderInLegend
{
	Auto = 0,
	Direct = 1,
	Reverse = 2
}

//Вариант источника значений на оси точек диаграммы
//since 8.3.10
enum PointsAxisValuesSource
{
	Auto = 0,
	Series = 1,
	Points = 2
}

//Вариант источника значений размера пузырька в диаграмме
//since 8.3.10
enum BubbleSizeValueSource
{
	None = 0,
	CommonSeries = 1,
	NextSeries = 2
}

//Вариант вычисления размера пузырька в диаграмме
//since 8.3.10
enum BubbleSizing
{
	IncreaseDiameter = 0,
	IncreaseArea = 1,
	DecreaseDiameter = 2,
	DecreaseArea = 3
}

//Вариант отображения отрицательных значений в пузырьковой диаграмме
//since 8.3.10
enum BubbleChartNegativeValuesShowMode
{
	DontShow as "DontShow" = 0,
	Abs as "Abs" = 1,
	Transparent as "Transparent" = 2,
	InvertColor as "InvertedBackColor" = 3
}

//Тип соединения точек в диаграмме
//since 8.3.10
enum PointsConnectionType
{
	Auto = 0,
	Connect = 1,
	DontConnect = 2	
}

//since 8.3.10
enum BoundaryDetectionMethod
{
	AutoDetect = 0,
	UseValue = 1,
	UseValueWithLimitations = 2
}

//Способ заполнения текста заголовка шкалы диаграммы
//since 8.3.10
enum ScaleTitleTextSource
{
	Auto as "Auto" = 0,
	CustomText as "UseText" = 1,
	AutoText as "AutoText" = 2
}

//Отображение заголовка шкалы диаграммы
//since 8.3.10
enum ShowChartScaleTitle
{
	Auto = 0,
	DontShow = 1,
	Show = 2
}

//Расположение заголовка шкалы диаграммы
//since 8.3.10
enum ScaleTitlePlacement
{
	WithAxis = 0,
	PlotArea = 1,
	SpecialArea = 2
}

//Порядок отображения точек в горизонтальной диаграмме
//since 8.3.10
enum BarChartPointsOrder
{
	Auto = 0,
	TopToBottom = 1,
	BottomToTop = 2
}

//since 8.3.10
class LabelArea
{
	ChartLabelLocation location
	double left = "0.5"
	double top = "0.5"
	contains Font font
	contains Color textColor
	contains Color backColor
	boolean transparent
	contains Border border
	contains Color borderColor
	MarkerType marker
	LabelsOrientation orientation //since 8.3.12
	double angle //since 8.3.12
}

//since 8.3.10
class ChartScale
{
	ShowChartScaleTitle showTitle
	ScaleTitleTextSource titleTextSource
	contains LocalStringMapEntry[] titleText
	contains LabelArea titleArea
	ScaleTitlePlacement titlePlacement
	//since 8.3.11
	GridLinesShowMode gridLinesShowMode
	ScaleLabelLocation scaleLabelLocation
	contains ChartLine gridLine
	contains Color gridLineColor
	contains Font labelFont
	contains Color labelColor
	LabelsOrientation labelOrientation
	contains LocalStringMapEntry[] labelFormat
	contains ChartLine scaleLine
	contains Color scaleLineColor
	int maxLabelRows
	int labelAngle
	ScaleLocation scaleLocation
	int scaleStep
	ScaleMarkLocation scaleMarkLocation
}

class TrendlineArray
{
	long seriesId
	contains Trendline[] line
}

//since 8.3.10
class Trendline
{
	TrendlineApproximationType approximationType
	int approximationDegree = "3"
	contains ChartLine line //Значение по умолчанию: Сплошная, толщина 1 TODO
	TrendlineFactor factor
	contains Color color
	contains LocalStringMapEntry[] text
	boolean showInLegend
	boolean showEquation
	boolean showDeterminationFactor
	MarkerType marker
	StockChartUsedPointValue stockChartUsedPointValue
	contains LabelArea equationArea
	//details anyType
}

//since 8.3.10
class AxisInterval
{
	boolean leftIsNum
	double leftNum
	com._1c.g5.v8.dt.mcore.Date leftDate
	boolean rightIsNum
	double rightNum
	com._1c.g5.v8.dt.mcore.Date rightDate
}

//since 8.3.10
class ChartAxis
{
	double baseValue
	contains AxisInterval interval
	BoundaryDetectionMethod minValueDetectionMethod
	BoundaryDetectionMethod maxValueDetectionMethod
}

class SeriesCalcInfo
{
	boolean enabled // Серия изображается (может быть выключено при ограничении
                          // количества серий).
    double min    // Расчетные данные (обычные и абсолютные минимумы и максимумы). 
    double max
    double absMin
    double absMax
    // Расчетные данные для круговых диаграмм.
    double startAngle // Начальный угол сектора.
    double stopAngle  // Конечный угол сектора.
    double percent    // Расчетный процент.
    String str  // Подпись.
    boolean m_isExpand     // Сектор расширяется.
    contains Point m_centerPoint // Центр эллипса для сектора (в случае расширения может 
                             // не совпадать с центром эллипса.
    int endX          // Конечная координата серии для отрисовки таблицы данных.
}

class RealDataItem
{
    contains Value dataValue
    contains Value infoValue              // Уточняющая информация
    String tooltip                      // Подсказка
    boolean isToolTipFormatted			// since 8.3.14
}

class SeriesProperties
{
	long ^id                            // Уникальный в рамках Chart идентификатор
	contains Value valInfo              // Расшифровка серии
	contains Color color                // Цвет серии
	contains ChartLine line                  // Стиль линии
	MarkerType marker                   // Маркер
	contains LocalStringMapEntry[] text // Имя серии
	boolean expand // isExpand          // На круговых диаграммах серия расширяема
	boolean indicator  // isIndicator   // Серия - индикатор на гистограммах
	boolean strIsChanged                // Имя было изменено
	contains SeriesCalcInfo info        // Расчетные данные
	contains Value key                  // Ключ
	boolean colorPriority               // Приоритет цвета

	ShowInChartLegend showGraphicalRepresentationOfDataInChartLegend
	ShowOnChart showGraphicalRepresentationOfDataOnChart
}

// Элемент данных
class ChartDataItem
{
	contains Value dataValue            // Собственно данные.
	double doubleValue
	contains Value valInfo              // Уточняющая информация
	String tooltip                      // Подсказка
	contains Point point                // Точка для текущей отрисовки
}

class ChartSeriesItem
{
	contains SeriesProperties properties // Свойства серии
	contains ChartDataItem[] points 	 // Вектор данных
}

// Свойства точки
class PointProperties
{
	long ^id                               // Уникальный в рамках Chart идентификатор. 
	contains Value valInfo                 // Расшифровка серии
	MarkerType marker                      // Маркер
	contains LocalStringMapEntry[] text    // Имя точки
	boolean strIsChanged                   // Имя было изменено
	
    // Дополнительные данные. Нужны для симметрии с сериями.
    contains Color color                   // Цвет
    contains ChartLine line                     // Стиль линии
    boolean expand // isExpand             // На круговых диаграммах серия расширяема
	boolean indicator  // isIndicator      // Серия - индикатор на гистограммах
	
	int intAdd                             // Сумматоры для диаграммы с областями и суммированием
	double doubleAdd
	
	int endX                               // Конечная координата серии для отрисовки таблицы данных.
    contains Value key                     // Ключ
	boolean colorPriority                  // Приоритет цвета
}


//    <xs:complexType name="GaugeChartQualityBand">
//        <xs:sequence>
//            <xs:element name="begin" type="xs:decimal" />
//            <xs:element name="end" type="xs:decimal" />
//            <xs:element name="backColor" type="tns:Color" />
//            <xs:element name="text" type="core:LocalStringType" minOccurs="0" />
//            <xs:element name="tooltip" type="core:LocalStringType" minOccurs="0" />
//            <xs:element name="textStr" type="xs:string" minOccurs="0" />
//            <xs:element name="tooltipStr" type="xs:string" minOccurs="0" />
//        </xs:sequence>
//    </xs:complexType>
class GaugeChartQualityBand
{
	int begin
	int end
	contains Color backColor
	contains LocalStringMapEntry[] text
	contains LocalStringMapEntry[] tooltip
	String textString     // textStr
	String tooltipString  // tooltipStr
	boolean useTextString
	boolean useToolTipString
}


//    <xs:complexType name="GaugeChartQualityBands">
//        <xs:sequence>
//            <xs:element name="item" type="tns:GaugeChartQualityBand" maxOccurs="unbounded" minOccurs="0" />
//        </xs:sequence>
//        <xs:attribute name="useTextStr" type="xs:boolean" />
//        <xs:attribute name="useTooltipStr" type="xs:boolean" />
//    </xs:complexType>
class GaugeChartQualityBands
{
	contains GaugeChartQualityBand[] items
	boolean useTextStr
	boolean useTooltipStr
}

class Chart
{
    // Уникальные идентификаторы серий и точек.
    long seriesCurId
    long pointsCurId
    
    boolean isSeriesDesign // Настраивать дизайн серий
    
    int realSeriesCount      // Количество серий реальных данных
    contains ChartSeriesItem[] realSeriesData
    contains ChartSeriesItem realExSeriesData // Объединенная серия
    int realPointCount       // Количество точек реальных данных
    contains PointProperties[] realPointData
    contains RealDataItem[] realDataItems    // it not used in binary serialization but save to xml

    boolean isPointsDesign // Настраивать дизайн точек

    int curSeries // Текущая серия
    int curPoint  // Текущая точка
    ChartType chartType  // Вид диаграммы
    ChartLabelType circleLabelType  // Вид подписей к круговой диаграмме
    String labelsDelimiter  // Строка - разделитель компонентов подписей
    ChartLabelLocation labelsLocation  // Расположение подписей
    contains LocalStringMapEntry[] lbFormat    // Формат значений в подписях
    contains LocalStringMapEntry[] lbpFormat    // Формат процентов в подписях        
    contains Color labelsColor // Цвет подписей
    contains Font labelsFont  // Фонт подписей 
    boolean transparentLabelsBkg // Прозрачный фон подписей
    contains Color labelsBkgColor  // Цвет фона подписей
    contains Border labelsBorder    // Рамка подписей
    contains Color labelsBorderColor    // Цвет рамки подписей
    
    CircleExpandMode circleExpandMode    // Режим выдвижения секторов круговых диаграмм.
    Chart3Dcrd chart3Dcrd    // 3D ориентация
    
    contains LocalStringMapEntry[] title    // Заголовок
    boolean isShowTitle    // Флаг показа заголовка
    boolean isShowLegend    // Флаг показа легенды
    contains Border ttlBorder    // Рамка заголовка
    contains Color ttlBorderColor    // Цвет рамки заголовка
    contains Border lgBorder    // Рамка легенды
    contains Color lgBorderColor     // Цвет рамки легенды
    contains Border chBorder    // Рамка Chart
    contains Color chBorderColor    // Цвет рамки chart
    boolean transparent
    contains Color bkgColor    // Цвет фона
    boolean isTrnspTtl     // Прозрачный фон заголовка
    contains Color ttlColor    // Цвет фона заголовка
    boolean isTrnspLeg    // Прозрачный фон легенды
    contains Color legColor     // Цвет фона легенды   
    boolean isTrnspCh    // Прозрачный фон области диаграммы
    contains Color chColor    // Цвет фона области диаграммы
    contains Color ttlTxtColor    // Цвет текста заголовка
    contains Color legTxtColor    // Цвет текста легенды
    contains Color chTxtColor    // Цвет текста диаграммы
    contains Font ttlFont    // Фонт заголовка
    contains Font legFont    // Фонт легенды
    contains Font chFont    // Фонт диаграммы
    boolean isShowScale     // Флаг показа шкалы
    boolean isShowScaleVL     // Флаг показа линий значений шкалы
    boolean isShowSeriesScale    // Флаг показа подписей серий
    boolean isShowPointsScale    // Флаг показа подписей точек
    boolean isShowValuesScale    // Флаг показа подписей шкалы значений
    contains LocalStringMapEntry[] vsFormat    // Формат шкалы значений
    LabelsOrientation xLabelsOrientation
    contains ChartLine scaleLine    // Линии шкалы диаграммы
    contains Color scaleColor    // Цвет линий шкалы диаграммы
    boolean isAutoSeriesName    // Разрешить генерацию имен серий по умолчанию
    boolean isAutoPointName    // Разрешить генерацию имен точек по умолчанию
    MaxSeriesMode maxMode    // Режим максимального числа серий
    int maxSeries     // Макс. число серий
    int maxSeriesPrc    // Макс. серий (процент)
    SpaceMode spaceMode    // Режим пробелов
    BigDecimal baseVal     // Базовое значение
    boolean isOutline    // Флаг окантовки
    int realPiePoint    // Активная точка для круговых диаграмм - реальные данные
    int realStockSeries // Активная серия для биржевых диаграмм - реальные данные.
    boolean isLight    // Флаг освещения
    boolean isGradient    // Флаг градиента
    boolean hideBaseVal    // Флаг блокировки базовых значений
    boolean dataTable    // Флаг показа таблицы данных
    boolean dtVerLines    // Флаг показа вертикальных линий в таблице данных
    boolean dtHorLines    // Флаг показа горизонтальных линий в таблице данных
    HorizontalAlign dtHAlign     // Выравнивание в таблице данных
    contains LocalStringMapEntry[] dtFormat    // Формат в таблице данных
    boolean dtKeys    // Флаг показа ключей в таблице данных
    PaletteKind paletteKind     // Вид палитры
    boolean legendScrollEnable    // Разрешено скролирование легенды
    contains Color surfaceColor    // Цвет поверхности
    RadarChartScaleType radarScaleType    // Тип шкалы лепестковых диаграмм
    GaugeChartValuesPresentation gaugeValuesPresentation    // Отображение значений измерительной диаграммы
    contains GaugeChartQualityBands gaugeQualityBands    // Коллекция полос измерительной диаграммы
    int beginGaugeAngle  // Начальный угол измерительной диаграммы (0 - 360)
    int endGaugeAngle    // Конечный угол измерительной диаграммы (0 - 360)
    int gaugeThickness   // Толщина шкалы измерительной диаграммы (1 - 10)
    GaugeChartLabelsLocation gaugeLabelsLocation    // Расположение подписей значений измерительной диаграммы
    boolean gaugeLabelsArcDirection     // Направление подписей измерительной диаграммы вдоль шкалы
    int gaugeBushThickness    // Толщина втулки измерительной диаграммы (0 - 10)
    contains Color gaugeBushColor    // Цвет втулки измерительной диаграммы
    
    boolean autoMaxValue     // Автоматическое определение максимального значения
    double userMaxValue      // Заданное максимальное значение
    boolean autoMinValue     // Автоматическое определение минимального значения
    double userMinValue      // Заданное минимальное значение
    
    // Проинициализирован ли лайоутер
    boolean elementsIsInit    
    boolean titleIsInit
    boolean legendIsInit
    boolean chartIsInit
    
    contains DoubleRect elementsChart     //  геометрия Chart
    contains DoubleRect elementsLegend    //  геометрия Legend
    contains DoubleRect elementsTitle     //  геометрия Title
    
    contains Color borderColor
    contains Border border
    
    String dataSourceDescription	// Описание DataSource. Например, область в мокселе.
    boolean isTransposition    // Включена транспозиция DataSource.
    boolean isTransposed    // Автоматическое транспонирование не в режиме DataSource выполнено
    boolean isDataSourceMode        // Включен режим работы с DataSource
    boolean autoTransposition    // Флаг автоматического траниспонирования не в режиме DataSource
    
    // Инициализировать новые значения генератором случайных чисел.
    // По умолчанию включено.
    // Выключается при первом setValue или при setDataSource.
    boolean isRandomizedNewValues = 'true'  
    EnSplineMode splineMode // m_modeSpline  Режим сглаживания графиков
    int splineStrain // m_percentSplineStrain "Натяжение" в точках гладкого графика (0 - 100)
    EnTranslucenceMode translucenceMode // m_modeTranslucence;  // Режим прозрачности.
    int translucencePercent // Значение альфа-канала для прозрачности
    
    float funnelNeckHeightPercent //  процент цилиндрической части - "горла" воронки. 
    float funnelNeckWidthPercent  //  процент ширины "горла" воронки от ее максимальной ширины.
    float funnelGapSumPercent     //  процент "зазоров" между сегментами воронки.
    
    EnMultiStageLinkMode multiStageLinkMode   // m_modeMultiStageLink      Режим соединения серий в гистограммах с накоплением
    contains ChartLine multiStageLinkLine          // m_lineMultiStageLink      Стиль линий соединений серий в гистограммах с накоплением.
    contains Color multiStageLinkColor        // m_colorMultiStageLink     Цвет линий соединений серий в гистограммах с накоплением.
    
    ChartAnimation animation    // Анимация диаграммы (проигрывать ли её)
    long rebuildTime            // Время последнего перестроения диаграммы
    
    transient Uuid ^id 
    
    SeriesOrderInLegend seriesOrderInLegend   //since 8.3.10
    contains ChartAxis valuesAxis   //since 8.3.10
    contains ChartAxis pointsAxis   //since 8.3.10
    PointsAxisValuesSource pointsAxisValuesSource   //since 8.3.10
    int pointsAxisSeries   //since 8.3.10
    BubbleSizeValueSource bubbleSizeValueSource   //since 8.3.10
    int bubbleSizeCommonSeries   //since 8.3.10
    BubbleSizing bubbleSizing   //since 8.3.10
    BubbleChartNegativeValuesShowMode bubbleChartNegativeValuesShowMode   //since 8.3.10
    int defaultBubbleSize = "10"   //since 8.3.10
    int minBubbleSize = "1"   //since 8.3.10
    int maxBubbleSize = "20"   //since 8.3.10
    PointsConnectionType pointsConnection   //since 8.3.10
    contains ChartScale pointsScale   //since 8.3.10
    contains ChartScale valuesScale   //since 8.3.10
    contains ChartScale seriesScale   //since 8.3.10
    BarChartPointsOrder barChartPointsOrder   //since 8.3.10
    int gradientPaletteMaxColors   //since 8.3.10
    contains Color gradientPaletteStartColor   //since 8.3.10
    contains Color gradientPaletteEndColor   //since 8.3.10
    contains TrendlineArray[] trendLinesArray   //since 8.3.10
    contains Color[] customPalette   //since 8.3.10
    
    contains ChartColorPaletteDescription colorPaletteDescription //since 8.3.12
    contains ChartColorPaletteDescription referenceBandsColorPaletteDescription //since 8.3.12
    
    contains ChartReferenceLines valuesReferenceLines //since 8.3.12
    contains ChartReferenceLines pointsReferenceLines //since 8.3.12
    contains ChartReferenceBands valuesReferenceBands //since 8.3.12
    contains ChartReferenceBands pointsReferenceBands //since 8.3.12

    NonnumericChartValueUse nonnumericValuesUse //since 8.3.13
    PointsConnectionAcrossSkippedChartValuesType pointConnectionAcrossSkippedValues //since 8.3.13

    ChartValuesToolTipShowMode valuesToolTipShowMode // since 8.3.14
    ChartValuesToolTipFillType valuesToolTipFillType // since 8.3.14
    ChartSelectionMode selectionMode // since 8.3.14
    ShowChartPopupReferenceLine pointsDropLinesShowMode  // since 8.3.14
    ShowChartPopupReferenceLine valuesDropLinesShowMode  // since 8.3.14
    // contains ChartSelectedObjects selectedObjects     // since 8.3.14  runtime only
    String distributedKey  // Ключ в хранилище           // since 8.3.14
    // String listStreamData // since 8.3.14  runtime only

    LegendPlacement legendPlacement	 		 //since 8.3.12
    PlotAreaPlacement plotAreaPlacement		 //since 8.3.12
    TitleAreaPlacement titleAreaPlacement		 //since 8.3.12
}

