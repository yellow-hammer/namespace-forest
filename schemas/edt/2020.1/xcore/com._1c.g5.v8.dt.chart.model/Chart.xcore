//since 8.3.12
class ChartReferenceBand 
{
	contains Value begin
	contains Value end
	contains LocalStringMapEntry[] labelText
	contains LocalStringMapEntry[] tooltip
	contains LabelArea labelArea
	contains Color color
	contains Value semitransparencyPercent
	contains ChartLine border
	contains Color borderColor
	contains Value borderSemitransparencyPercent
	contains Value details
	ChartReferenceBandBorderPosition position
	double displayAreaBegin
	double displayAreaEnd
	boolean beginIsPointNumber
	boolean endIsPointNumber
}

