//        <xs:enumeration value="Bright" />
//        <xs:enumeration value="Soft" />
//        <xs:enumeration value="Warm" />
//        <xs:enumeration value="Cold" />
//        <xs:enumeration value="Blue" />
//        <xs:enumeration value="Orange" />
//        <xs:enumeration value="Green" />
//        <xs:enumeration value="Yellow" />
//        <xs:enumeration value="Gray" />
//        <xs:enumeration value="Custom" />
//        <xs:enumeration value="Gradient" />
//        <xs:enumeration value="Auto" />
//      </xs:restriction>
//    </xs:simpleType>
enum PaletteKind
{
    PKClassic8 as "Palette8" = 0,   //  ePKClassic8 = 0, // Палитра8 (классическая).
    PK32 as "Palette32" = 1         //  ePK32            // Палитра32
    Pastel as "Pastel" = 2          //  ePKPastel,       // Бледные цвета
    Bright as "Bright" = 3          //  ePKBright,       // Яркие цвета
    Soft as "Soft" = 4              //  ePKSoft,         // Мягкие цвета
    Warm as "Warm" = 5              //  ePKWarm,         // Тёплые цвета
    Cold as "Cold" = 6              //  ePKCold,         // Холодные цвета
    Blue as "Blue" = 7              //  ePKBlue,         // Синяя
    Orange as "Orange" = 8          //  ePKOrange,       // Оранжевая
    Green as "Green" = 9            //  ePKGreen,        // Зелёная
    Yellow as "Yellow" = 10         //  ePKYellow,       // Жёлтая
    Gray as "Gray" = 11             //  ePKGrey,         // Серая
    Custom as "Custom" = 12         //  ePKCustom,       // Произвольная
    Gradient as "Gradient" = 13     //  ePKGradient,     // Градиентая
    Auto as "Auto" = 14             //  ePKAuto,         //  - ePK32
    SoftAdaptive as "SoftAdaptive" = 15             //  ePKSoftAdaptive,         //  - Мягкая адаптивная
}

