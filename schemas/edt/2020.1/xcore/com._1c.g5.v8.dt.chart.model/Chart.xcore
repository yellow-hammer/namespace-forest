//since 8.3.12
class ChartReferenceBands 
{
	contains ChartReferenceBand[] chartReferenceBand
}

//since 8.3.12
enum LegendPlacement
{
	Auto = 0,
	Left = 1,
	Right = 2,
	Top = 3,
	Bottom = 4,
	UseCoordinates = 5,
	None = 6
}

//since 8.3.12
enum PlotAreaPlacement
{
	Auto = 0,
	UseCoordinates = 1,
	EmptySpace = 2
}

//since 8.3.12
enum TitleAreaPlacement 
{
	Auto = 0,
	UseCoordinates = 1,
	LeftTop = 2,
	Top = 3, 
	RightTop = 4,
	LeftBottom = 5,
	Bottom = 6,
	RightBottom = 7
	None = 8
}

