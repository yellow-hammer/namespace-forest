	int green
	int blue
	op int red() {
		getRed()
	}
	op int green() {
		getGreen()
	}
	op int blue() {
		getBlue()
	}
}

class ColorRef extends Color
{
	refers Color[1] color
	op int red() {
		if(color === null) throw new IllegalStateException("Color cannot be null") else color.red()
	}
	op int green() {
		if(color === null) throw new IllegalStateException("Color cannot be null") else color.green()
	}
	op int blue() {
		if(color === null) throw new IllegalStateException("Color cannot be null") else color.blue()
	}
	op CompositeId compositeId() {
		if(color === null) throw new IllegalStateException("Color cannot be null") else color.compositeId()
	}
}

