enum SourceType
{
	InputByString
	,               //< Поля, участвующие во вводе по строке
    CharacteristicKind
	,          //< Поля, участвующие в видах дополнительных характеристик
    Characteristic
	,              //< Поля, участвующие в дополнительных характеристиках
    StandardFields
	,              //< Поля, свойства которых можно переопределять
    ChoiceParamLinks
	,            //< Поля, участвующие в СвязяхПараметровВыбора и СвязьПоТипу
    CharacteristicMainFields
	,    //< Поля, в типе которых есть тип, порожденный некоторыми объектами МД (Справочники и ПВХ)
    EDBTableKeyFields
	,           //< Поля ключа таблицы внешнего источника данных
    FieldsForLocking //< Поля, по которым можно блокировать
}

