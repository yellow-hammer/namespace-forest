/*
 * Can handle its own types if it is produced typeset.
 * To get types of this typeset you should use types(context) method
 */
class TypeSet extends TypeItem
{
	refers Type[] types
	op Type[] types(EObject context) {
		return McoreTypeSetExtension::getTypes(context, this)
	}
}

class NumberQualifiers
{
	// From https://msdn.microsoft.com/en-us/library/ms190476.aspx
	// For example, the number 123.45 has a precision of 5 and a scale of 2
	// Precision is the number of digits in a number
	int precision
	//Scale is the number of digits to the right of the decimal point in a number
	int scale
	boolean nonNegative
}

class StringQualifiers
{
	int length
	boolean fixed
}

enum DateFractions
{
	DateTime = 0
	Date = 1
	Time = 2
}

class DateQualifiers
{
	DateFractions dateFractions
}

class BinaryQualifiers
{
	int length
	boolean fixed
}

class TypeDescription
{
	refers TypeItem[] types
	contains NumberQualifiers numberQualifiers
	contains StringQualifiers stringQualifiers
	contains DateQualifiers dateQualifiers
	contains BinaryQualifiers binaryQualifiers
}

