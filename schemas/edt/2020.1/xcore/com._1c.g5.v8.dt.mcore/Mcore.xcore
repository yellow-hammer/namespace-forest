// type ------------------------------------------------------------------------
abstract class TypeItem extends DuallyNamedElement, Environmental // TODO: TypeSets are not available in bsl maybe TypeItem shouldn't extend Environmental?  
{
}

class Type extends TypeItem
{
	contains Ctor[] ctors
	contains ContextDef contextDef
	contains Event[] events
	boolean sysEnum
	boolean createdByNewOperator = "true"
	refers TypeItem parentType
	boolean iterable
	boolean indexAccessible
	boolean exchangeWithServer
	contains TypeContainer collectionElementTypes
	op Event[] allEvents() {
		val allEvents = new ArrayList<Event>();
		allEvents.addAll(this.getEvents());
		for (refContextDef : this.getContextDef().allRefContextDefs()) {
			if (refContextDef.eContainer() instanceof Type) {
				val refType = refContextDef.eContainer() as Type;
				if (refType != this) {
					allEvents.addAll(refType.getEvents());
				}
			}
		}
		return new UnmodifiableEList(allEvents);
	}
}

class Ctor
{
	int minParams // non-negative
	int maxParams // >= minParams or -1 (unlimited)
	contains Parameter[] params
}

class FakeCtor
{
	contains FakeParameter[] params
	String typeName
}

