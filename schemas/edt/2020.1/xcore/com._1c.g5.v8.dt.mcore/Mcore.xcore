	Single = 1
	Double = 200
	Embossed = 2
	Indented = 3
	Underline = 4
	DoubleUnderline = 5
	Rounded = 6
	Overline = 7
}

class BorderRef extends Border
{
	refers Border[1] border
	op BorderStyle style() {
		if(border === null) throw new IllegalStateException("Border cannot be null") else border.style()
	}
	op int width() {
		if(border === null) throw new IllegalStateException("Border cannot be null") else border.width()
