// BM Optimizations ------------------------------------------------------------------------
type List wraps com._1c.g5.v8.dt.mcore.impl.DelegatingRefContextDefEList<ContextDef>

/* 
 * ContextDef implementation which stores URIs of refContextDefs and resolves them each time they are requested. 
 */
class RefContextDelegatingContextDef extends ContextDef
{
	String[] refContextDefUris
	volatile transient List delegateListCache
	op ContextDef[] getRefContextDefs() {
	    RefContextDelegatingContextDefExtension::getContextDefs(this)
	}
	op ContextDef getReferencedContextDef(String contextDefUriValue) {
	    RefContextDelegatingContextDefExtension::getContextDef(this, contextDefUriValue)
	}
}

