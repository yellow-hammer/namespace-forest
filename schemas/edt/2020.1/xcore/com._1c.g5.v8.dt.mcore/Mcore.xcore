// context ---------------------------------------------------------------------
class ContextDef extends Environmental
{
	contains Property[] properties
	contains Method[] methods
	@ForceDirectReference
	refers ContextDef[] refContextDefs
	op Property[] allProperties() {
		val allProps = new ArrayList<Property>(2 * properties.size)
		allProps.addAll(properties)
		for (refCntxDef : allRefContextDefs) {
			allProps.addAll(refCntxDef.properties)
		}
		new UnmodifiableEList(allProps)
	}
	op Method[] allMethods() {
		val allMeths = new ArrayList<Method>(2 * methods.size)
		allMeths.addAll(methods)
		for (refCntxDef : allRefContextDefs) {
			allMeths.addAll(refCntxDef.methods)
		}
		new UnmodifiableEList(allMeths)
	}
	op ContextDef[] allRefContextDefs() {
		val allRefCntxDefs = new ArrayList<ContextDef>
		if (!refContextDefs.empty) {
			val refCntxDefSet = new HashSet<ContextDef>
			for (refCntxDef : refContextDefs) {
				for (refCntxDef2 : refCntxDef.allRefContextDefs) {
					if (refCntxDefSet.add(refCntxDef2))
						allRefCntxDefs.add(refCntxDef2)
				}
				if (refCntxDefSet.add(refCntxDef))
					allRefCntxDefs.add(refCntxDef)
			}
		}
		new UnmodifiableEList(allRefCntxDefs)
	}
}

class ContextDefWithRefItem extends ContextDef
{
	refers Property[] refProperties
	refers Method[] refMethods
	
	op Property[] allProperties() {
		val items = super.allProperties()
		val collectionProperties = new ArrayList<Property>(items.size + refProperties.size)
		collectionProperties.addAll(items)
		collectionProperties.addAll(refProperties)
		new UnmodifiableEList(collectionProperties)
	}
	
	op Method[] allMethods() {
		val items = super.allMethods()
		val collectionMethods = new ArrayList<Method>(items.size + refMethods.size)
		collectionMethods.addAll(items)
		collectionMethods.addAll(refMethods)
		new UnmodifiableEList(collectionMethods)
	}
}

class Property extends DuallyNamedElement, Environmental
{
	boolean readable
	boolean writable
	boolean dependsOnMetadata
	String compatibilityMode // x.y.z
	contains TypeContainer[1] typeContainer
	op TypeItem[] getTypes() {
		typeContainer.allTypes()
	}
}

abstract class TypeContainer
{
	op TypeItem[] allTypes()
}

class TypeContainerRef extends TypeContainer
{
	refers TypeItem[] types
	op TypeItem[] allTypes() {
		if (types === null) {
			return new BasicEList<TypeItem>
		} else {
			return types
		}
	}
}

class TypeContainerDef extends TypeContainer
{
	contains TypeItem[] types
	op TypeItem[] allTypes() {
		if (types === null) {
			return new BasicEList<TypeItem>
		} else {
			return types
		}
	}
}

class DerivedProperty extends Property
{
	refers EObject source
}

abstract class AbstractMethod extends DuallyNamedElement
{
	contains ParamSet[1..*] paramSet
	boolean retVal
	refers TypeItem[] retValType
	String compatibilityMode // x.y.z
	op ParamSet actualParamSet(int numParam) {
		var bestSet = paramSet.get(0)
		for (ParamSet ^set : paramSet) {
			if (numParam >= ^set.minParams && (numParam <= ^set.maxParams || ^set.maxParams == -1)) {
				if (numParam == ^set.minParams)
					return ^set
				else
					bestSet = ^set
			}
		}
		return bestSet
	}
}

class Method extends AbstractMethod, Environmental
{
}

class Event extends AbstractMethod, Environmental
{
	boolean serverCallWithContextNotAllowed
}

class ParamSet
{
	int minParams
	int maxParams
	contains Parameter[] params
}

