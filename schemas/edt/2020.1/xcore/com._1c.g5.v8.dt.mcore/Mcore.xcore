abstract class Font
{
    op String faceName()
    op int height()
    op float heightF()
    op boolean bold()
    op boolean italic()
    op boolean underline()
    op boolean strikeout()
    op int scale()
    op CompositeId compositeId()
}

interface MutableFont
{
	op void setFaceName(String faceName)
	op void setHeight(float height)
	op void setBold(boolean bold)
	op void setItalic(boolean italic)
	op void setUnderline(boolean underline)
	op void setStrikeout(boolean strikeout)
	op void setScale(int scale)
}

class FontDef extends Font, MutableFont
{
    String[1] faceName = ""
    float height
    boolean bold
    boolean italic
    boolean underline
    boolean strikeout
    int scale = "100"

    op String faceName() { 
    	getFaceName()
    }
    
    op int height() { 
    	(0.5f + getHeight()) as int
    }
    
    op float heightF() { 
    	getHeight()
    }
    op void setHeight(int height) { 
    	this.height = height as float
    }
    
    op boolean bold() { 
    	isBold()
    }
    
    op boolean italic() { 
    	isItalic()
    }
    
    op boolean underline() { 
    	isUnderline()
    }
    
    op boolean strikeout() { 
    	isStrikeout()
    }
    
    op int scale() { 
    	getScale()
    }
    
    op CompositeId compositeId() {
    	null
    }
}

class FontRef extends Font, MutableFont
{
    refers Font[1] font
    unsettable String faceName
    unsettable float height
    unsettable boolean bold
    unsettable boolean italic
    unsettable boolean underline
    unsettable boolean strikeout
    unsettable int scale = "100"

    op String faceName() { 
    	FontRefExtension::faceName(this)
    }
    
    op int height() { 
    	FontRefExtension::height(this)
    }
    
    op float heightF() { 
    	FontRefExtension::heightF(this)
    }
    
    op boolean bold() { 
    	FontRefExtension::bold(this)
    }
    
    op boolean italic() { 
    	FontRefExtension::italic(this)
    }
    
    op boolean underline() { 
    	FontRefExtension::underline(this)
    }
    
    op boolean strikeout() { 
    	FontRefExtension::strikeout(this)
    }
    
    op int scale() { 
    	FontRefExtension::scale(this)
    }
    
	op CompositeId compositeId() { 
		if (font === null) 
			throw new IllegalStateException("Font cannot be null") else font.compositeId()
	}
}

