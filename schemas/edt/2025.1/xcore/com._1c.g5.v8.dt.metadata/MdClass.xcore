    refers com._1c.g5.v8.dt.mcore.Field multipleValuesOrderField //since 8.3.21

    op boolean validate(EDiagnosticChain diagnostics, EMap<Object, Object> context)
    {
        CharacteristicsDescriptionValidator::validate(this, diagnostics, context)
    }
}

