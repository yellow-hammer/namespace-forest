class ChartOfAccountsPredefinedItem extends PredefinedItem
{
    String code
    AccountType accountType
    boolean offBalance
    String order
    refers AccountingFlag[] accountingFlags                        // перечислены для которых включено
    contains ExtDimensionType[] extDimensionTypes
    contains ChartOfAccountsPredefinedItem[] childItems
}

class ExtDimensionType
{
    refers ChartOfCharacteristicTypesPredefinedItem characteristicType
    boolean turnover
    refers ExtDimensionAccountingFlag[] extDimensionAccountingFlags         // перечислены для которых включено
}

class ChartOfAccountsPredefined extends Predefined
{
    contains ChartOfAccountsPredefinedItem[] items

    op PredefinedItem[] predefinedItems()
    {
        val EList<? extends PredefinedItem> _items = items
        return _items as EList<PredefinedItem>
    }
}

