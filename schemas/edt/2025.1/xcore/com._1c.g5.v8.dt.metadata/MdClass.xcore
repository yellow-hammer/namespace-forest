class AdjustableBoolean
{
    boolean common
    contains ForRoleType[] ^for
}

class ForRoleType
{
    boolean value
    refers Role[1] role
}

// Standard commands
class StandardCommand extends DuallyNamedElement, Command
{
    refers com._1c.g5.v8.dt.mcore.CommandGroup group
    contains AdjustableBoolean visible
    contains TypeDescription commandParameterType
}

interface StandardCommandSource
{
    contains transient StandardCommand[] standardCommands    // inferred
}

interface SupportFilterCriterion
{
    op TypeItem selectCriterionTypeRef()
}

