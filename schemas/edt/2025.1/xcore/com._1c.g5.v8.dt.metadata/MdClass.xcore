class MdObjectReferenceTypeDescription extends TypeDescription
{
    refers EObject mdObject
    
    op TypeItem[] getTypes() {
        FunctionalModelExtensionProvider.getInstance().getExtension(IMdDbViewFieldDefExtension).
            getDerivedDbViewFieldDefTypeItems(this);
    }
    
    op NumberQualifiers getNumberQualifiers() {
        FunctionalModelExtensionProvider.getInstance().getExtension(IMdDbViewFieldDefExtension).
            getNumberQualifiers(this);
    }
    op StringQualifiers getStringQualifiers() {
        FunctionalModelExtensionProvider.getInstance().getExtension(IMdDbViewFieldDefExtension).
            getStringQualifiers(this);
    }
    op DateQualifiers getDateQualifiers() {
        FunctionalModelExtensionProvider.getInstance().getExtension(IMdDbViewFieldDefExtension).
            getDateQualifiers(this);
    }
    op BinaryQualifiers getBinaryQualifiers() {
        FunctionalModelExtensionProvider.getInstance().getExtension(IMdDbViewFieldDefExtension).
            getBinaryQualifiers(this);
    }    
}

