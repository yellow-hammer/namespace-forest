//done, add
// see class IHippoGeneratorMainElement (src\mngbase\IHippoGenerator.h)
class MainElementGeneratorContext extends ElementWithAutoCommandBarBaseGeneratorContext, GroupBaseGeneratorContext
{
    boolean generateIntermediateMainLayouter
    GenerateIntermediateMainLayouter generateIntermediateMainLayouterMode
    String title = ""
    FormItemSpacing horSpacing
    FormItemSpacing verSpacing
    FormChildrenAlign childrenAlign
    ItemHorizontalAlignment horAlgn
    ItemVerticalAlignment verAlgn
    refers ElementBaseGeneratorContext pIntermediateMainLayouter
    /**
     * Получить навигатор.
     */
    refers ElementBaseGeneratorContext pNavigator
    /*
     * Установить признак выполнения в режиме Конфигуратора
     */
    // virtual void SCOM_API setDesignTimeMode(bool mode) = 0;
    /**
     * Получить верхнюю командную панель.
     */
    refers CommandBarGeneratorContext pTopCommandBar // since 8.5.1
    /**
     * Получить нижнюю командную панель.
     */
    refers CommandBarGeneratorContext pBottomCommandBar // since 8.5.1
    /**
     * Получить командную панель создания.
     */
    refers CommandBarGeneratorContext pFABCommandBar // since 8.5.1
    String autoCommandBarName
    // Absolete. Compatibility only.
    boolean topCB
    boolean bottomCB
    refers MobileTransformations pMobileTransformations
    String leftCaptionCommandText = ""
    String leftCaptionCommandTooltip = ""
    String leftCaptionCommandShortCut = ""
    String defButtonCommandText = ""
    String defButtonCommandTooltip = ""
    String defButtonCommandShortCut = ""
    // changed type
    // refers ElementBaseGeneratorContext pRightCaptionCommandBar
    refers CommandBarGeneratorContext pRightCaptionCommandBar
    // TODO must be called while initializing
    op void init() {
        PNavigator = LayoutGenerationContextFactory.eINSTANCE.createNavigatorGeneratorContext();
        PTopCommandBar = LayoutGenerationContextFactory.eINSTANCE.createCommandBarGeneratorContext; // since 8.5.1
        PBottomCommandBar = LayoutGenerationContextFactory.eINSTANCE.createCommandBarGeneratorContext; // since 8.5.1
        PFABCommandBar = LayoutGenerationContextFactory.eINSTANCE.createCommandBarGeneratorContext; // since 8.5.1
    }
}

enum GenerateIntermediateMainLayouter
{
    eGIMLAuto = 0
    eGIMLAlways = 1
    eGIMLNever = 2
}

