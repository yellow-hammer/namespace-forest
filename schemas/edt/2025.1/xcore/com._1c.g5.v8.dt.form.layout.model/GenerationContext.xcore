//done, add
class TableGeneratorContext extends GroupBaseGeneratorContext, ElementWithAutoCommandBarBaseGeneratorContext, ElementWithSelectedItemsActionPanelBaseGeneratorContext, RichElementBaseGeneratorContext, IAutoAdditionsProviderGeneratorContext
{
    boolean readOnly
    boolean inplaceEdit
    boolean ULType
    SearchStringLocation searchStringLocation = "None"
    refers ElementBaseGeneratorContext pSearchString
    ViewStatusLocation viewStatusLocation = "None"
    refers ElementBaseGeneratorContext pViewStatus
    SearchControlLocation searchControlLocation = "None"
    contains ElementBaseGeneratorContext[] lineEditFormFields
    FormItemSpacing horizontalSpacing
    FormItemSpacing verticalSpacing
    ItemHorizontalAlignment horizontalAlign
    FormChildrenAlign childrenAlign
    HierarchyPanelLocation hierarchyPanelLocation = "None" // since 8.5.1
    refers ElementBaseGeneratorContext pHierarchyPanel // since 8.5.1
    /**
     * Установить панель действий строки.
     */
    refers ElementBaseGeneratorContext pRowActionsPanel // since 8.5.1
    refers ElementBaseGeneratorContext pVerticalScrollPanel // since 8.5.1 ???
    /**
     * Установить дополнение элемента формы "строка поиска" для панели множественного выделения
     */
    refers ElementBaseGeneratorContext pSelectedItemsActionsPanelSearchStringRepresentation
    /**
     * Установить дополнение элемента формы "управление поиском" для панели множественного выделения
     */
    refers ElementBaseGeneratorContext pSelectedActionsItemsPanelSearchControl
    /**
     * Добавить поле для формы редактирования строки.
     */
    op void addLineEditFormField(ElementBaseGeneratorContext lineEditFormField) {
        lineEditFormFields.add(lineEditFormField);
        lineEditFormField.PParent = this
    }
}

