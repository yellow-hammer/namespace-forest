interface IElementGeneratorContext
{
}

interface ElementBaseGeneratorContext extends IElementGeneratorContext
{
    // changed type 
    // refers FormItem pLogFormElement
    refers FormVisualEntity pLogFormElement
    refers IElementGeneratorContext pParent
    LFTargetPlatform targetPlatform
    ClientInterfaceVariant interfaceVariant
}

interface ElementWithContextMenuBaseGeneratorContext extends IElementGeneratorContext
{
    // changed type
    // refers ElementBaseGeneratorContext pContextMenu
    refers ContextMenuGeneratorContext pContextMenu
}

interface RichElementBaseGeneratorContext extends ElementBaseGeneratorContext, ElementWithContextMenuBaseGeneratorContext
{
    FormElementTitleLocation titleLocation
    String title = ""
    boolean stretchableTitle
    Color titleTextColor
    Font titleFont
    String tooltip = ""
    boolean formattedTooltip
    TooltipRepresentation tooltipRepresentation
    refers Decoration pExtTooltip
    // changed type
    // refers ElementBaseGeneratorContext pHippoGenExtTooltip
    refers TextDecorationGeneratorContext pHippoGenExtTooltip
    boolean changedFormattedString
    boolean markRequiredComplete // since 8.5.1
}

interface RichFieldBaseGeneratorContext extends RichElementBaseGeneratorContext
{
}

interface GroupBaseGeneratorContext extends ElementBaseGeneratorContext
{
    boolean compat838
    boolean compat8319
    contains ElementBaseGeneratorContext[] children
    op void addChild(ElementBaseGeneratorContext pChild) {
        pChild.setPParent(this);
        children.add(pChild);
    }
}

interface SlaveElementBaseGeneratorContext extends ElementBaseGeneratorContext
{
    boolean slaveMode
    String slaveLogFormElementName = ""
    String slaveName = ""
    String slaveTitle = ""
    HippoLayouterCategory[] slaveCategories
    boolean slaveVisible
    boolean slaveEnabled
    boolean slaveReadOnly
    boolean slaveSkipOnInput
    boolean slaveDefaultControl
}

interface SlaveFormElementBaseGeneratorContext extends SlaveElementBaseGeneratorContext
{
    int slaveWidth
