enum HippoLaySplitterDirection
{
    Horizontal as "Hor" = 0
    Vertical as "Ver" = 1
}

enum HippoLaySplitterMode
{
    Move = 0
    Scale = 1
}

enum HippoLayouterGroupRole
{
    // Обычная группа, не требующая специальной обработки.
    NoSpecialRole = 0
    // Группа, включающая в себя каринку и текст кнопки вида "Гипперссылка".
    // Требуется расстановка паддингов.
    HyperlinkButtonGroupRole = 1
    // Группа, включающая в себя таблицу и её предопределённые - командную панель и/или
    // состояние просмотра. Требуется расстановка паддингов.
    TableGroupRole = 2
    // Область заголовка в мобильной платформе.
    MobileTitleAreaRole = 3
    // Группа, содержащая контент страницы.
    PageContentRole = 4
}

enum HippoLayouterEdge
{
    Left = 0
    Top = 1
    Right = 2
    Bottom = 3
    None = 4
    Auto = 5
}

enum HippoLayouterMenuElementRepresentation
{
    Text = 0
    Picture = 1
    TextPicture = 2
}

// for more info, see mngcore/IHippoLayouter.h
enum HippoLayouterCategory
{
    MainLayouter as "Main" = 0 // eHLCMainLayouter // Элемент, выполняющий роль основного лайоутера со скроллированием.
    // Не используется для колонок и строк.
    Title as "Title" = 1 // eHLCTitle // Элемент, выполняющий роль заголовка. Не используется для колонок и строк.
    AlignedTitle as "AlignedTitle" = 2 // eHLCAlignedTitle // Элемент, являющийся выравниваемым заголовком. Должен использоваться совместно с
    // eHLCTitle. Также используется у колонки. В этом случае без eHLCTitle.
    ExtTooltip as "ExtTooltip" = 3 // eHLCExtTooltip // Элемент выполняющий роль расширенной подсказки. Может непосредственно её отображать или
    // быть кнопкой её вызова. Не используется для колонок и строк.
    CloseBtnImage as "CloseBtnImage"  = 4 // eHLCCloseBtnImage // Элемент выполняющий роль кнопки (иконки) закрытия. Не используется для колонок и строк.
    ShowData as "ShowData" = 5 // eHLCShowData // Элемент, отображающий основные данные. Не используется для колонок и строк.
    WidthDependedHeight as "WidthDependedHeight" = 6 // eHLCWidthDependedHeight // Высота элемента зависит от его ширины. Не используется для колонок и строк.
    ChangeHeightOnChangeData as "ChangeHeightOnChangeData" = 7 // eHLCChangeHeightOnChangeData // Элемент может динамически менять свою высоту при изменении данных. Не используется для колонок и строк.
    // Не может использоваться совмесно с eHLCWidthDependedHeight. Если такой элемент появится,
    // для него следует указать eHLCChangeHeightOnChangeData без eHLCWidthDependedHeight. Зависимость от данных
    // подразумевает зависимость от ширины тоже.
    HorStretchPriority as "HorStretchPriority" = 8 // eHLCSHorStretchPriority // Приоритет расширения по горизонтали. Элемент расширяется в первую очередь, а сжимается в последнюю.
    // Не используется для колонок и строк. Не может быть установлена одновременно с eHLCHorCompressPriority.
    HorCompressPriority as "HorCompressPriority" = 9 // eHLCHorCompressPriority // Приоритет сжатия по горизонтали. Элемент сжимается в первую очередь, а расширяется в последнюю.
    // Не используется для колонок и строк. Не может быть установлена одновременно с eHLCSHorStretchPriority.
    VerCompressPriority as "VerCompressPriority" = 10 // eHLCVerCompressPriority // Приоритет сжатия по горизонтали. Элемент сжимается в первую очередь, а расширяется в последнюю.
    // Не используется для колонок и строк. Не может быть установлена одновременно с eHLCSHorStretchPriority.
    Spacing as "Spacing" = 11 // eHLCSpacing // Колонка или строка используется в качестве разделителя между элементами.
    // Для элементов не используется. 
    NoCalcHorContent as "NoCalcHorContent" = 12 // eHLCNoCalcHorContent // Элемент не имеет собственного размера по горизонтали, т.е. при вычислении размеров колонок
    // такие элементы пропускаются.
    NoCalcVerContent as "NoCalcVerContent" = 13 // eHLCNoCalcVerContent // Элемент не имеет собственного размера по вертикали, т.е. при вычислении размеров строк
    // такие элементы пропускаются.
    AlwaysVerticalAlign as "AlwaysVerticalAlign" = 14 // eHLCAlwaysVerticalAlign // Элемент выравнивается по вертикали вне зависимости от совпадения его вертикального положения с вертикальным положением группы.
    // Не используется для колонок и строк.
    Align as "Align" = 15 // eHLCAlign // Колонка или строка используется для выравнивания.
    // Для элементов не используется.
    Primary as "Primary" = 16 // eHLCLFLPrimary // Основной элемент, соответствующий элементу формы. По аналогии с LFL лайоутером.
    // Не используется для колонок и строк.
    AutoChangeVAlign as "AutoChangeVAlign" = 17 // eHLCAutoChangeVAlign // Если ширина элемента меньше максимальной, менять вертикальное
    // выравнивание с ценрального на верхнее.
    // Не используется для колонок и строк.
    AutoChangeRowsCount as "AutoChangeRowsCount" = 18 // eHLCAutoChangeRowsCount // Если ширина элемента меньше максимальной, менять количество строк с одной на две.
    // Не используется для колонок и строк.
    ContentStretchableMode as "ContentStretchableMode" = 19 // eHLCContentStretchableMode // Специальный режим растягивания под контент. Максимальная ширина, в том числе усиановленная в 0, управляет ограничением
    // автоширины, а не границей растягивания. Не используется для колонок и строк.
    ContentIndepended as "ContentIndepended" = 20 // eHLCContentIndepended // Размеры колонки или строки заданы абсолютно и не зависят от содержимых объектов.
    // Для элементов не используется.
    BehaviorIcon as "BehaviorIcon" = 21 // eHLCBehaviorIcon // Элемент выполняющий роль иконки скрытия / раскрытия / всплывания.
    // Не используется для колонок и строк.
    MasterColumn as "MasterColumn" = 22 // eHLCMasterColumn // Управляющая колонка. Ей соответствуют управляемые колонки во вложенных гридах.
    // При расчёте ширины "изнутри наружу" ширина управляющей колонки считается только по управляемым.
    // При установке ширины "снаружи внутрь" ширина управляемых колонок соответствует ширине управляющей.
    // Для элементов не используется.
    SlaveColumn as "SlaveColumn" = 23 // eHLCSlaveColumn // Управляемая колонка. Ей соответствуют управляющая колонки в родительском гридах.
    // При расчёте ширины "изнутри наружу" ширина управляющей колонки считается только по управляемым.
    // При установке ширины "снаружи внутрь" ширина управляемых колонок соответствует ширине управляющей.
    // Для элементов не используется.
    HasSingleElement as "HasSingleElement" = 24 // eHLCHasSingleElement // В гриде есть елемент, который занимает только данную колонку или строку. Для элементов не используется.
    Layered as "Layered" = 25 // eHLCLayered // Элемент находится в верхних (плавающих) слоях. Не используется для колонок и строк.
    LinkToAnchor as "LinkToAnchor" = 26 // eHLCLinkToAnchor // Только при установленой категории eHLCLayered. Элемент привязан к якорю. Связь по IHippoLayFormElement::getAnchorName().
    // Не может сочетаться с eHLCFullScreen.
    // Не используется для колонок и строк.
    FullScreen as "FullScreen" = 27 // eHLCFullScreen // Только при установленой категории eHLCLayered. Элемент растягивается на весь экран.
    // Не может сочетаться с eHLCLinkToAnchor.
    // Не используется для колонок и строк.
    Anchor as "Anchor" = 28 // eHLCAnchor // Якорь для привязки элемента из верхнего слоя. Связь по IHippoLayFormElement::getAnchorName().
    // Не используется для колонок и строк.
    Sticky as "Sticky" = 29 // eHLCSticky // Прилипающий элемент.
    // Не используется для колонок и строк.
    Splitter as "Splitter" = 30 // eHLCSplitter // В колонке или строке размещён сплиттер. Для элементов не используется.
    SlaveChangeVAlign as "SlaveChangeVAlign" = 31 // eHLCSlaveChangeVAlign // Менять вертикальное выравнивание с центрального на верхнее синхронно с элементом у которого установлена
    // категория eHLCAutoChangeVAlign. Не используется для колонок и строк.
    NoHorStretchable as "NoHorStretchable" = 32 // eHLCNoHorStretchable // Элемент не растягивается по ширине вне зависимости от своего контента. Не используется для колонок и строк.
    NoVerStretchable as "NoVerStretchable" = 33 // eHLCNoVerStretchable // Элемент не растягивается по высоте вне зависимости от своего контента. Не используется для колонок и строк.
    SlaveVisibility as "SlaveVisibility" = 34 // eHLCSlaveVisibility // Видимость данного элемента не является достаточным поводом для видимости группы в которой он расположен.
    // Не используется для колонок и строк.
    AmpersandIsData as "AmpersandIsData" = 35 // eHLCAmpersandIsData // Амперсанд в строке не должен интерпретироваться как подчёркивание. Не используется для колонок и строк.
    PostGeneratorSizesInDLU as "PostGeneratorSizesInDLU" = 36 // eHLCPostGeneratorSizesInDLU // Размеры элемента на выходе из генератора заданы в DLU.
    MobileLeftCaption as "MobileLeftCaption" = 37 // eHLCMobileLeftCaption // Элемент располагается в области заголовка формы слева.
    // Не используется для колонок и строк.
    MobileRightCaption as "MobileRightCaption" = 38 // eHLCMobileRightCaption // Элемент располагается в области заголовка формы справа.
    // Не используется для колонок и строк.
    MobileAutoGeneratedCloseButton as "MobileAutoCloseButton" = 39 // eHLCMobileAutoGeneratedCloseButton // Элемент представляет собой автосгенерированную кнопку "Закрыть".
    // Не используется для колонок и строк.
    MobileSpecialRightAlign as "MobileSpecialRightAlign" = 40 // eHLCMobileSpecialRightAlign // Если у родительской группы выравнивание подчинённых равно eLFCATitlesLeftDataAuto и у элемента горизонтальное
    // положение в группе равно Лево, то элемент смещается вправо.
    MobileNoMobileTransformation as "MobileNoMobileTransformation" = 41 // eHLCMobileNoMobileTransformation // Трансформация элемента производится по правилам обычной платформы.
    MobileSeparatedColumn as "MobileSeparatedColumn" = 42 // eHLCMobileSeparatedColumn // Данную колонку в мобильном приложении нужно отделять справа вертикальной чертой.
    // Для элементов не используется.
    MobileSkippedColumns as "MobileSkippedColumns" = 43 // eHLCMobileSkippedColumns // Таблица содержит отброшенные колонки.
    MobileTableGroupData as "MobileTableGroupData" = 44 // eHLCMobileTableGroupData // Таблица содержит группы, связанные с текущей строкой.
    ContainMobileSeparatedColumns as "ContainMobileSeparatedColumns" = 45 // eHLCContainMobileSeparatedColumns // Содержит отделённые чертой мобильные колонки. Непосредственно или среди дочерних.
    MarkRequired as "MarkRequired" = 46 // eHLCMarkRequired // Отметка обязательного заполнения.
    CheckboxOrRadioButtonLabel as "CheckboxOrRadioButtonLabel" = 47 // eHLCCheckboxOrRadioButtonLabel // Заголовок поля переключателя или поля флажка вида Флажок или Выключатель.
    SelectedItemsActionsPanelGroup as "SelectedItemsActionsPanelGroup" = 48 // eHLCSelectedItemsActionsPanelGroup // Группа панели действий выделенных строк.
    SelectedItemsActionsPanelInGridGroup as "SelectedItemsActionsPanelInGridGroup" = 49 // eHLCSelectedItemsActionsPanelInGridGroup // Группа панели действий выделенных строк, расположенной в гриде.
    SelectedItemsActionsPanelInMoxelGroup as "SelectedItemsActionsPanelInMoxelGroup" = 50, // eHLCSelectedItemsActionsPanelInMoxelGroup // Группа панели действий выделенных строк, расположенной в мокселе.
    SelectedItemsActionsPanelButton as "SelectedItemsActionsPanelButton" = 51 // eHLCSelectedItemsActionsPanelButton // Кнопка панели действий выделенных строк.
    SelectedItemsActionsPanelLabelButton as "SelectedItemsActionsPanelLabelButton" = 52 // eHLCSelectedItemsActionsPanelLabelButton // Кнопка ярлыка панели действий выделенных строк.
    SelectedItemsActionsPanelCommandBar as "SelectedItemsActionsPanelCommandBar" = 53 // eHLCSelectedItemsActionsPanelCommandBar // Командная панель панели действий выделенных строк.
    SelectedItemsActionsPanelInGridCommandBar as "SelectedItemsActionsPanelInGridCommandBar" = 54, // eHLCSelectedItemsActionsPanelInGridCommandBar // Командная панель панели действий выделенных строк, расположенной в гриде.
    SelectedItemsActionsPanelInMoxelCommandBar as "SelectedItemsActionsPanelInMoxelCommandBar" = 55, // eHLCSelectedItemsActionsPanelInMoxelCommandBar // Командная панель панели действий выделенных строк, расположенной в мокселе.
    RowActionsPanelGroup as "RowActionsPanelGroup" = 56 // eHLCRowActionsPanelGroup // Группа действий строки.
    RowActionsPanelCommandBar as "RowActionsPanelCommandBar" = 57 // eHLCRowActionsPanelCommandBar // Командная панель панели действий строки.
    HierarchyPanelMenuGroup as "HierarchyPanelMenuGroup" = 58 // eHLCHierarchyPanelMenuGroup // Группа панели действий иерархического списка.
    CollapsibleGroupTitle as "CollapsibleGroupTitle" = 59 // eHLCCollapsibleGroupTitle // Заголовок свертываемой группы.
    GroupTitle as "GroupTitle" = 60 // eHLCGroupTitle // Элемент, являющийся заголовком группы. Должен использоваться совместно с eHLCTitle.
    TopCommandBar as "TopCommandBar" = 61 // eHLCTopCommandBar // Верхняя командная панель формы в интерфейсе Версия85. Как eHLCLayered плюс дополнительная обработка в веб-клиенте
    SearchControl as "SearchControl" = 62 // eHLCSearchControl // Управление поиском
    BottomCommandBar as "BottomCommandBar" = 63 // eHLCBottomCommandBar // Нижняя командная панель формы в интерфейсе Версия85.
    CreateButton as "CreateButton" = 64 // eHLCCreateButton // Кнопка создания в интерфейсе Версия85.
    FABCommandBar as "FABCommandBar" = 65, // eHLCFABCommandBar // Командная панель для float action button в интерфейсе Версия85.
    CollapsibleGroupCollapseButton as "CollapsibleGroupCollapseButton" = 66, // eHLCCollapsibleGroupCollapseButton // Кнопка "Свернуть" внизу свертываемой группы в интерфейсе "Версия 8.5", когда родительская группа горизонтальная.
    EditInCommandBar as "EditInCommandBar" = 67 // eHLCEditInCommandBar // Поле ввода внутри командной панели.
    Last = 68
}

