interface HippoLayVirtualGridBase extends HippoLayGroupBase 
{
    contains VirtualColumn[] columns
    contains VirtualRow[] rows
    ItemHorizontalAlignment childrenGridHAlign
    ItemVerticalAlignment childrenGridVAlign
    op void addRow() {
        val row = LayoutDescriptionModelFactory.eINSTANCE.createVirtualRow()
        row.description = LayoutDescriptionModelFactory.eINSTANCE.createVirtualGridElementDescription
        rows.add(row)
    }
    op void insertRow(int index) {
        if (index >= rows.size()) {
            addRow();
        } else {
            val row = LayoutDescriptionModelFactory.eINSTANCE.createVirtualRow()
            row.description = LayoutDescriptionModelFactory.eINSTANCE.createVirtualGridElementDescription
            rows.add(index, row);
        }
    }
    op void addColumn() {
        val column = LayoutDescriptionModelFactory.eINSTANCE.createVirtualColumn()
        column.description = LayoutDescriptionModelFactory.eINSTANCE.createVirtualGridElementDescription
        columns.add(column)
    }
    op void insertColumn(int index) {
        if (index >= columns.size()) {
            addColumn();
        } else {
            val column = LayoutDescriptionModelFactory.eINSTANCE.createVirtualColumn()
            column.description = LayoutDescriptionModelFactory.eINSTANCE.createVirtualGridElementDescription
            columns.add(index, column);
        }
    }
}

