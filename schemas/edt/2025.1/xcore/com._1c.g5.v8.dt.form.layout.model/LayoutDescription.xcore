    eSysFormControllerTypes = 3 // Типы, которые могут быть cистемными реквизитами формы.
    eEditTypes = 4 // Типы, которые могут отображаться в ЭУ поле ввода. 
    eListTypes = 5 // Списковые типы.
    eEnumTypes = 6 // Перечисления.
    eRefTypes = 7 // Ссылочные    типы.
    eClientTypes = 8 // Типы, доступные на тонком клиенте.
    eFormSerializableTypes = 9 // Типы свойств, значения которых могут сериализоваться в форме.
    eFormNestedPropertyDisabledTypes = 10 // Типы, которые запрещены для вложенных реквизитов формы.
    eTabularPartTypes = 11 // Табличные части.
    eRecordSetTypes = 12 // Наборы записей.
    eMobileAppFilterTypes = 13 // Типы, доступные в мобильном приложении
    eUserNonAvailableColumnTypes = 14 // Типы, недоступные для пользователя в качестве колонки реквизита.
    eExtensionTypes = 15 // Типы из расширения. Данная категория доступна только в конфигураторе.
}

