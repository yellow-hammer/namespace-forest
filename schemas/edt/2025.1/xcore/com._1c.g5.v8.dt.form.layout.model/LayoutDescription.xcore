//Elements
class HippoLayStaticText extends HippoLayElementWCMFormElementBase, HippoLayRichFieldBase, HippoLayElementWithCustomization
{
    ItemVerticalAlignment vAlign = "Center"
    ItemHorizontalAlignment hAlign
    boolean hyperlink
    String tooltip = ""
    String shortCut = ""
    String formatString = ""
    boolean markNegatives
    Border border
    boolean passwordMode
    boolean formatted
    int minTitleRowsCount
    boolean useStdFontForWidthCalculate
    boolean useStdFontForMaxWidthCalculate
    boolean pseudoHyperlink
    TextBreakMode textBreakMode = "WordBreak"
    int scale = "100"
    boolean useOutput
    int leftCalcPadding
    int topCalcPadding
    int rightCalcPadding
    int bottomCalcPadding
    op int getCalcPadding(HippoLayouterEdge edge) {
        switch (edge) {
            case LEFT:
                return leftCalcPadding
            case TOP:
                return topCalcPadding
            case RIGHT:
                return rightCalcPadding
            case BOTTOM:
                return bottomCalcPadding
            default:
                throw new IllegalArgumentException()
        }
    }
    op void setCalcPadding(HippoLayouterEdge edge, int padding) {
        switch (edge) {
            case LEFT:
                leftCalcPadding = padding
            case TOP:
                topCalcPadding = padding
            case RIGHT:
                rightCalcPadding = padding
            case BOTTOM:
                bottomCalcPadding = padding
            default:
                throw new IllegalArgumentException()
        }
    }
}

