class SlaveGroupIndexEntry wraps Map$Entry
{
	String key
	contains VerGroupResult value
}

type IntPair wraps Pair<Integer, Integer>

class ContextPositionsPair
{
	refers ElementBaseTransformationContext<?,?> first
	contains Positions second
	
	op void init()
	{
		second = LayoutTransformationContextFactory.eINSTANCE.createPositions();
	}
}

// TODO nocase compare!
class GridPositionsEntry wraps Map$Entry
{
	String key
	IntPair value
}

type GridPositionsMap wraps EMap<String, Pair<Integer, Integer>>

type ColoredGroupDataList wraps EList<ColoredGroupData>

class VerGroupResult
{
   refers RootBaseTransformationContext<?,?> pVerGroup
   contains ResultCacheMapEntry[] resultCache
   boolean rangesInit
   int constantRanges
}

type ChildrenPath wraps List<Integer>

class IndexEntry wraps Map$Entry
{
	String key
	ChildrenPath value
}

class Child 
{
	boolean ifLeaf // Тип элемента - Простой элемент (в том числе объединённая группа) или делегирующая группа.
	contains LeafChild leafChild // Простой элемент (в том числе объединённая группа). Используется когда ifLeaf == true.
	contains DelegateGroupChild delegateGroupChild // Делегирующая группа. Используется когда ifLeaf == false.
	int index
	
	op void init() {
		leafChild = LayoutTransformationContextFactory.eINSTANCE.createLeafChild();
		delegateGroupChild = LayoutTransformationContextFactory.eINSTANCE.createDelegateGroupChild();
	}
}

    // Делегирующая группа.
    class DelegateGroupChild
    {
        FormChildrenGroup grouping
        Color backColor
        contains Child[] children
        String groupLogFormElementName

// TODO
//        DelegateGroupChild() :
//            backColor(Color::eAutoColor, 0)
//        {
//        }
    }


class SelfResultCacheEntry wraps Map$Entry
{
	refers HTVariantKey key
	contains Result value
}

class ColoredGroupData
{
	String logFormElementName
    contains Rect rect
    Color color
}

/*class ColoredGroupInfo
{
    contains Rect position
    contains Rect paddingLevels
}*/

class Rect
{
    int top
    int bottom
    int left
    int right
    
    op int width()
    {
		return right - left;
	}
	
	op int height()
	{
		return bottom - top;
	}
}

class Positions
{
    contains GridPositionsEntry[] gridPositions
    contains ColoredGroupData[] coloredGroupPositions
}

class MegaGroupTransformationContext
{
	contains SlaveGroupIndexEntry[] slaveGroupIndex
	contains IndexEntry[] index
    contains Child[] children
    GridPositionsMap pCurGridPositions
    ColoredGroupDataList pCurColoredGroupPositions
    contains SelfResultCacheEntry[] selfCache
     
    refers RootBaseTransformationContext<?,?> pParentElement
    refers RootBaseTransformationContext<?,?> pInternalVariantBeforeAdapting
    refers RootBaseTransformationContext<?,?> pInternalVariantAfterAdapting
    
    contains GridPositionsEntry[] gridPositionsBeforeAdapting
    contains ColoredGroupData[] coloredGroupPositionsBeforeAdapting
    contains GridPositionsEntry[] gridPositionsAfterAdapting
    contains ColoredGroupData[] coloredGroupPositionsAfterAdapting
    
    int slaveVerGroupNumerator
    
    contains ContextPositionsPair[] internalVariantsWithAdapting
    
	refers HippoLayGroupBase layoutElement
	VisualComputer visualComputer
	TransformatorAdditionalInfoProvider additionalInfoProvider
	
	//refers RootBaseTransformationContext<? extends HippoLayElementBase, ? extends RootBaseCalculationContext> parent
    
    FormChildrenGroup grouping
    LFTargetPlatform targetPlatform
    ClientInterfaceVariant interfaceVariant
    ClientOSInfo osInfo
    CompatibilityMode compatibilityMode
    FormItemSpacing horSpacingVariant
    int horSpacing
    FormItemSpacing verSpacingVariant
    int verSpacing
    FormChildrenAlign childrenAlign
    ItemHorizontalAlignment hAlign
    ItemVerticalAlignment vAlign
    boolean externalTitleAlign
    int maxTargetWidth
    int maxTargetHeight
    boolean adpatedToMobilePlatform
    
    CalculateAdditionalOptions options
    boolean mobileBlockModeEnabled
    int mobileRowMinHeight
    int mobileRowMinIndent
    int mobileRowHorIndent
    int mobileRowRoundRadius
}

class LeafChild
{
        refers RootBaseTransformationContext<?,?> pLeafChild
        contains ResultCacheMapEntry[] resultCache
        boolean rangesInit
        int constantRanges
        
}

