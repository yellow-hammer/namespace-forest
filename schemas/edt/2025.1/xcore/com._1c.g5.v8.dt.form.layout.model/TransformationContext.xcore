}

type VisualComputer wraps IPlatformVisualComputer

type  TransformatorAdditionalInfoProvider wraps IHippoTransformatorAdditionalInfoProvider

/**
 * Base interface of the EDT form layout transformation context.<br>
 * The transformation phase performs the size adjusting based on settings of the managed form and its structure of elements.
 * 
 * @author Alexander Tretyakevich
 */
interface RootBaseTransformationContext<T extends HippoLayElementBase, C extends RootBaseCalculationContext>
{
	refers T layoutElement
	refers C calculationContext	
	refers GroupSimpleChild containmentInfo
	VisualComputer visualComputer
	TransformatorAdditionalInfoProvider additionalInfoProvider
	
	refers RootBaseTransformationContext<? extends HippoLayElementBase, ? extends RootBaseCalculationContext> parent
}

interface ElementBaseTransformationContext<T extends HippoLayElementBase, C extends ElementBaseCalculationContext> extends RootBaseTransformationContext<T, C>
{
	boolean enableAlignByExternalCondition
	ClientOSInfo osInfo
} 

interface FormElementBaseTransformationContext<T extends HippoLayFormElementBase, C extends FormElementBaseCalculationContext> extends ElementBaseTransformationContext<T, C>
{
	boolean compat839 
	boolean keepMinWidth
}  

interface GroupBaseTransformationContext<T extends HippoLayElementBase, C extends GroupBaseCalculationContext> extends ElementBaseTransformationContext<T, C>
{
	contains RootBaseTransformationContext<? extends HippoLayElementBase, ? extends RootBaseCalculationContext>[] children
	
	op void addChild(RootBaseTransformationContext<? extends HippoLayElementBase, ? extends RootBaseCalculationContext> child)
	{
		children.add(child);
		child.parent = this;
	}
	
	op void remove(RootBaseTransformationContext<? extends HippoLayElementBase, ? extends RootBaseCalculationContext> child)
	{
		if (!children.remove(child))
		{
			Assert.isTrue(false);
		}
		child.parent = null;
	} 
}

// Подчинённый элемент для простых групп.
