    boolean leftAlignInit
}

/**
 *  bool m_limitsConstantRangesInit - boolean limitsConstantRangesInit
 *  unsigned m_limitsConstantRanges - int limitsConstantRanges
 *  std::map<HTVariantKey, Estimate> m_limitsCache
 */
interface ElementWithLimitsBaseTransformationContext<T extends HippoLayElementBase, C extends ElementWithLimitsBaseCalculationContext> extends RootBaseTransformationContext<T, C> 
{
	boolean limitsConstantRangesInit
	int limitsConstantRanges
	contains LimitsCacheMapEntry[] limitsCache
}

