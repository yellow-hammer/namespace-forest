enum HorStrategy 
{
	/**
	 * Компактные подписи для лучшего выравнивания. Не используется в общем цикле размещения.
	 */
	eHSAuto = 0,
	/**
	 * Компактные подписи для лучшего выравнивания. Не используется в общем цикле размещения.
	 */
	eHSCompactTitle = 1,                   
	/**
	 * Расширенные подсказки снизу при автоположении (кроме флажков).
	 */
    eHSExtTooltipsAtBottom = 2,
	/**
	 * Сжимать до рекомендованной ширины. Для растягиваемых элементов до максимума между maxWidth и
	 * рекомендованной шириной с учётом ограничений растягивания. Для элментов со ступенчатым
	 * изменением ширины до максимальной ступеньки, меньшей или равной maxWidth.
	 * Не может быть больше нормальной ширины.
	 */
    eHSSmartCompressToRecomendedWidth = 3, 
	/**
	 * Сжимать до рекомендованной ширины.
	 */
    eHSCompressToRecomendedWidth = 4, 
	/**
	 * Вертикальная ориентация групп с авто группировкой, отработанная на более высоком уровне.
	 */
    eHSBeforeVerticalGrouping = 5,
	/**
	 * Вертикальная ориентация групп с авто группировкой.
	 */
    eHSVerticalGrouping = 6,
	/**
	 * Отключать выравнивание ширин кнопок.
	 */
    eHSDontAlignButtons = 7, 
	/**
	 * Сжимать до минимальной ширины. Для растягиваемых элементов до максимума между maxWidth и
	 * минимальной шириной с учётом ограничений растягивания. Для элментов со ступенчатым
	 * изменением ширины до максимальной ступеньки, меньшей или равной maxWidth.
	 * Не может быть больше нормальной ширины.
	 */
    eHSSmartCompressToMinWidth = 8, 
	/**
	 * Сжимать до минимальной ширины.
	 */
    eHSCompressToMinWidth = 9, 
	/**
	 * Отключать выравнивание заголовокв полей. В остальном как eHSSmartCompressToMinWidth.
	 */
    eHSDontAlignTitles = 10,
	/**
	 * Заголовки с автоположением наверх (кроме флажков). В остальном как eHSSmartCompressToMinWidth.
	 */
    eHSTitlesOnTop = 11,
	/**
	 * Аналогично eHSTitlesOnTop. Используется в группах формы с вертикальной группировкой при
	 * определении максимаоьной ширины не самых широких элементов.
	 */
    eHSTitlesOnTopSecondPhase = 12, 
	/**
	 * Сжимать любой ценой. До минимума между maxWidth и минимальной шириной с учётом растягивания.
	 */
    eHSCompressWidth = 13 
}

enum VerStrategy
{
	/**
	 * Всё по умолчанию.
	 */
	eVSAuto = 0, 
	/**
	 * Сжимать до минимальной высоты. Для растягиваемых элементов до максимума между maxHeight и
	 * минимальной высотой с учётом ограничений растягивания.
	 * Не может быть больше нормальной высоты.
	 */
    eVSSmartCompressToMinHeight = 1,
    /**
     * Сжимать до минимальной высоты.
     */
    eVSCompressToMinHeight =2
}

/**
 * Результат трансформации.
 */
enum HTEVariantCategory
{
 	/**  
 	 * Всё хорошо.
 	 */
    eHTEVCStandard = 0,                       
    /**  Ошибка выравнивания заголовков.  */
    eHTEVCAlignmentError = 1,                     
    /** Ширина элемента меньше минимальной.  */
    eHTEVCWidthError = 2,                         
    /**  Ширина группы больше заданной.  */
    eHTEVCGroupWidthError = 3,                    
    /** Высота группы больше заданной.  */
    eHTEVCGroupHeightError = 4,                   
    /** Ширина формы меньше заданной.  */
    eHTEVCFormWidthError = 5,                     
    /** Высота формы меньше заданной.  */
    eHTEVCFormHeightError = 6,                    
    /** Внутренняя ошибка.  */
    eHTEVCInternalErrorFunctionNotImplemented = 7 
}

enum StrategyConstantRange
{
    eSCRNone = 0,                                                   // Диапазона нет.
    eSCRAuto_CompressWidth = 1,                                // Больше или равен eHSAuto и меньше eHSCompressWidth.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны
                                                                    // adaptiveGroupingCount, maxWidth, noExternalAlign.
    eSCRAuto_SmartCompressToRecomendedWidth = 2,               // Больше или равен eHSAuto и меньше eHSSmartCompressToRecomendedWidth.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны 
                                                                    // adaptiveGroupingCount, maxWidth.
    eSCRAuto_SmartCompressToRecomendedWidthNoCompactTitle = 4, // Больше или равен eHSAuto и меньше eHSSmartCompressToRecomendedWidth. Но не eHSCompactTitle.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны 
                                                                    // adaptiveGroupingCount, maxWidth.
    eSCRAuto_SmartCompressToMinWidth = 8,                      // Больше или равен eHSAuto и меньше eHSSmartCompressToMinWidth.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны
                                                                    // adaptiveGroupingCount, maxWidth.
    eSCRAuto_VerticalGrouping = 16,                             // Больше или равен eHSAuto и меньше eHSVerticalGrouping.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны
                                                                    // adaptiveGroupingCount, maxWidth.
    eSCRAuto_DontAlignButtons = 32,                             // Больше или равен eHSAuto и меньше eHSDontAlignButtons.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны
                                                                    // adaptiveGroupingCount, maxWidth.
    eSCRAuto_TitlesOnTop = 64,                                  // Больше или равен eHSAuto и меньше eHSTitlesOnTop.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны
                                                                    // adaptiveGroupingCount, maxWidth, noExternalAlign.
    eSCRCompressToRecomendedWidth_SmartCompressToMinWidth = 128, // Больше или равен eHSCompressToRecomendedWidth и меньше eHSSmartCompressToMinWidth.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны 
                                                                    // adaptiveGroupingCount, maxWidth.
    eSCRAuto_CompressToMinHeight = 256                           // Больше или равен eVSAuto и меньше или равен eVSCompressToMinHeight.
                                                                    // Если элемент возвращает данный диапазон, то в нём не важны 
                                                                    // maxHeight.
}

enum ConstantRangesLevel
{
    eCRLLevelNone = 0,
    eCRLLevelSmartCompressToRecomendedWidth = 1,
    eCRLLevelVerticalGrouping = 2,
    eCRLLevelDontAlignButtons = 3,
    eCRLLevelSmartCompressToMinWidth = 4,
    eCRLLevelTitlesOnTop = 5,
    eCRLLevelCompressWidth = 6
}

enum Margin
{
    eMTop = 0,
    eMBottom = 1,
    eMLeft = 2,
    eMRight = 3
}  

class Estimate
{
	int width
	int alignedTitleWidth
	int height
	HorStrategy horStrategy
	VerStrategy verStrategy
	int adaptiveGroupingCount
	int maxWidth
	int maxHeight
	HTEVariantCategory category
}

class HTVariantKey
{
	int complexKey
	int maxWidth
	int maxHeight
	HorStrategy horStrategy
    VerStrategy verStrategy
    int adaptiveGroupingCount
    boolean noExternalAlign
    GetVariantAdditionalOptions options
    
    op int hashCode()
    {
    	return Objects.hashCode(
			complexKey,
			maxWidth,
			maxHeight,
			horStrategy.getValue(),
			verStrategy.getValue(),
			adaptiveGroupingCount,
			noExternalAlign
		)
    }
    
    op boolean equals(Object key)
    {
		if (key instanceof HTVariantKey) {
			return key.complexKey == complexKey && key.maxWidth == maxWidth && key.maxHeight == maxHeight &&
				key.horStrategy.getValue() == horStrategy.getValue() &&
				key.verStrategy.getValue() == verStrategy.getValue() &&
				key.adaptiveGroupingCount == adaptiveGroupingCount && key.noExternalAlign == noExternalAlign;
		}
		return false;
    }
}

