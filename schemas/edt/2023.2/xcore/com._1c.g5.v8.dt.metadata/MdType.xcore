abstract class AbstractMdType
{
    Uuid[1] typeId
    Uuid[1] valueTypeId
}

abstract class MdType extends AbstractMdType
{
    transient short category // inferred and used by MdTypeIndex
    contains transient Type ^type // inferred
}

abstract class MdTypeSet extends AbstractMdType
{
    contains transient TypeSet typeSet // inferred
}

class MdRefType extends MdType
{
    contains transient EmptyRef emptyRef // inferred
}

class EmptyRef
{
}

