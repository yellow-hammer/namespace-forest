/**
 * IHippoLayLogicGroup* m_pOriginalLogicGroup - Won't transfer, redundant
 * bool m_collapsible - boolean collapsible
 * bool m_collapsed - boolean collapsed
 * HippoTransformatorGroupCacheableChild m_titleElement; // Элемент заголовка
 * std::wstring m_originalTitle - String originalTitle
 * unsigned m_textLength - int textLength
 * unsigned m_groupWidth - int groupWidth 
 * unsigned m_groupHeight - int groupHeight
 * LogicGroupInternalRepresentation m_representation - LogicGroupInternalRepresentation representation
 * bool m_throughAlign - boolean throughAlign 
 */
class LogicGroupCalculationContext extends FormGroupBaseCalculationContext, ElementWithLimitsBaseCalculationContext
{
	UsualGroupBehavior behavior
    boolean collapsed  
    String originalTitle
    int textLength
    int groupWidth
    int groupHeight
    boolean throughAlign
    boolean finalVerGrouping
    int maxTargetHeight
    LogicGroupInternalRepresentation representation
    
    contains ElementBaseTransformationContext<?,?> titleElement
    contains ElementBaseTransformationContext<?,?> pPopUpElement
    
    //TODO check why we need this
    refers HippoLayLogicGroup pOriginalLogicGroup
}

