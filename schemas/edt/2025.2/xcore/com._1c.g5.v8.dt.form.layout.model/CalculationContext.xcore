class StringToElementTransformationContextMapEntry wraps Map$Entry
{
	String key
	contains ElementBaseTransformationContext<?,?> value
}

/**
 * Целевые платформы генерации формы.
 * 
 * see v8\src\core\UITypes.h
 */
enum LFTargetPlatform 
{
	/** Платформа не играет роль. */
	eLFTPDontSpecific = 0,
	/** Тонкий или толстый клиент. */       
	eLFTThinThickClient = 1,          
	/** Мобильная платформа. */
	eLFTPMobilePlatform = 2,         
	/** Эмуляция мобильной платформы. */
	eLFTPMobilePlatformEmulation = 3
	/** Тонкий клиент на мобильной платформе */
	eLFTPMobileThinClient = 4
	/** Эмуляция тонкого клиента на мобильной платформе */
	eLFTPMobileThinClientEmulation = 5
	/** Веб-клиент */
    eLFTPWebClient = 6 // since 8.5.1
    /** Мобильный веб-клиент */ 
    eLFTPMobileWebClient = 7 // since 8.5.1
}

/**
 * Отображение закладок
 */
enum TabsRepresentationInt
{
	None = 0
	Top
	Bottom
	LeftHor
	RightHor
	MobileSwipe
	MobileTop
	MobileBottom
	MobileVer
	Auto
}

/**
 * Режим работы группы.
 */
enum GroupMode
{
	eGMStandard // Обычный режим.
	eGMSlaveMegaHor // Горизонтальная группа для расчёта мегагруппы.
	eGMSlaveMegaVer // Вертикальная группа для расчёта мегагруппы.
}

/**
 * Base interface of the EDT form layout size calculation context.<br>
 * The calculation phase performs the size computation and fills the tree-organized context for the next phase (transformation).
 * 
 * @author Alexander Tretyakevich
 */
interface RootBaseCalculationContext
{
}

// IHippoTransformatorContainedElement analog
interface IContainedElementCalculationContext
{
	Font defFont
}

/**
 * IHippoLayElementPtr m_pOriginalElement - T layoutElement
 * IHippoTransformatorElement* m_pParent - LayoutCalculationContext<T> parent
 * LFTargetPlatform m_targetPlatform - LFTargetPlatform targetPlatform
 * LFInterfaceVariant m_interfaceVariant - LFInterfaceVariant interfaceVariant
 * CompatibilityMode compatibilityMode - CompatibilityMode compatibilityMode
 * unsigned m_minWidthForCompressedElements - minWidthForCompressedElements
 * uint32_t m_categoriesHolder - TODO check the lifecycle - where it belongs to     
 */
interface ElementBaseCalculationContext extends RootBaseCalculationContext
{
	LFTargetPlatform targetPlatform = "eLFTPDontSpecific"
	ClientInterfaceVariant interfaceVariant = "DontSpecific"
	CompatibilityMode compatibilityMode
	int minWidthForCompressedElements = "0"
	boolean adpatedToMobilePlatform
	CalculateAdditionalOptions options
}

/**
 * IHippoLayElementPtr m_pCloneElement - HippoLayElementBase pCloneElement
 * bool m_firstCallOfGetVariantFormElementBase - Won't transfer, redundant
 */
interface FormElementBaseCalculationContext extends ElementBaseCalculationContext
{
	refers HippoLayElementBase pCloneElement			
}

/**
 * Children m_children - contains RootBaseCalculationContext<? extends HippoLayElementBase>[] children
 */
interface GroupBaseCalculationContext extends ElementBaseCalculationContext
{
} 

/**
 *  bool m_limitsConstantRangesInit - Goes to transformation context
 *  unsigned m_limitsConstantRanges - Goes to transformation context
 *  std::map<HTVariantKey, Estimate> m_limitsCache - - Goes to transformation context
 */
interface ElementWithLimitsBaseCalculationContext extends RootBaseCalculationContext
{
	
}

/** 
 * Basic set of data for any form group-enabled element (logical group, form, etc).
 * 
 * Hippo fields:<br>
 * LFChildrenGrouping m_originalGrouping - FormChildrenGroup originalGrouping
 * unsigned m_childrenMaxAdaptiveGroupingFormGroupLevels - int childrenMaxAdaptiveGroupingFormGroupLevels
 * LFElementSpacing m_horSpacingVariant - FormItemSpacing horSpacingVariant
 * unsigned m_horSpacing - int horSpacing
 * LFElementSpacing m_verSpacingVariant - FormItemSpacing verSpacingVariant 
 * unsigned m_verSpacing - int verSpacing
 * unsigned m_splitterSize - int splitterSize
 * HorizontalAlignment m_hAlign - ItemHorizontalAlignment hAlign
 * VerticalAlignment m_originalVAlign - ItemVerticalAlignment originalVAlign
 * VerticalAlignment m_curChildrenVAlign - Moved to the transformation context //TODO used in calculation
 * LFChildrenAlign m_childrenAlign - FormChildrenAlign childrenAlign
 * unsigned m_iOSGroupHorIndent - Won't transfer at the moment
 * unsigned m_iOSRowVerIndent - Won't transfer at the moment 
 * IHippoTransformatorMegaGroupPtr m_pMegaGroup - MegaGroupCalculationContext megaGroup
 * m_pCB - TODO check what is a callback
 * bool m_slaveMode = boolean slaveMode
 *  
 */
interface FormGroupBaseCalculationContext extends GroupBaseCalculationContext
{
	ItemVerticalAlignment curChildrenVAlign
	FormChildrenGroup originalGrouping = "Vertical"
	int childrenMaxAdaptiveGroupingFormGroupLevels
	FormItemSpacing horSpacingVariant
	int horSpacing
	FormItemSpacing verSpacingVariant
	int verSpacing
	int splitterSize
	ItemHorizontalAlignment hAlign
	ItemVerticalAlignment originalVAlign
 	FormChildrenAlign childrenAlign

    GroupMode groupMode = "eGMStandard"
    boolean slaveEnableExternalAlign
    boolean slaveEnableSplitters = "true"
    
    String slaveLogFormElementName
    String slaveBaseName
    boolean slaveHorGrouping = "true"
    ItemHorizontalAlignment slaveHAlign = "Left"
    ItemVerticalAlignment slaveVAlign = "Top"
    FormItemSpacing slaveHorSpacingVariant = "Single"
    int slaveHorSpacing
    FormItemSpacing slaveVerSpacingVariant = "Single"
    int slaveVerSpacing
    FormChildrenAlign slaveChildrenAlign = "None"
    boolean slaveGroupVisible = "true"
    boolean slaveGroupEnabled = "true"
    int maxTargetWidth 
}

/**
 * Size calculation context for the root element of the form.
 * 
 * Hippo fields:<br>
 * m_mainLayouter - moved to the transformation context 
 * m_formWidth - moved to the transformation context
 * m_formHeight - moved to the transformation context
 * m_pLeftCaptionElement - TODO
 * m_pRightCaptionElement - TODO
 */
class FormCalculationContext extends FormGroupBaseCalculationContext, ElementWithLimitsBaseCalculationContext
{
	
}

