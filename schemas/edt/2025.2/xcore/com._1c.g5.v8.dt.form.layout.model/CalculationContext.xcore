/*
 * HippoTransformatorMeasurer* m_pMeasurer - Won't transfer, redundant
 * unsigned m_logicRowsHeight - int logicRowsHeight
 * unsigned m_formattedStringHeight - int formattedStringHeight
 * bool m_canSeparate - boolean canSeparate
 * unsigned m_rowsCnt - int rowsCnt
 * unsigned m_maxStringWidth - int maxStringWidth
 * unsigned m_horAdd - int horAdd
 * unsigned m_verAdd - int verAdd
 * std::wstring m_curTitleForCalculation - String curTitleForCalculation
 * bool m_curTitleForCalculationInLines - boolean curTitleForCalculationInLines
 * std::vector<std::wstring> m_lines;
 * std::vector<bool> m_hardLines;
 * bool m_autoWidth;
 * bool m_firstCallOfGetVariantStaticText;
 * bool m_recomendedAndMinimumVariantsConsistent;
 * NonFormattedHeightDescrs m_nonFormattedHeightDescrs;
 * FormattedHeightDescrs m_formattedHeightDescrs;
 * bool m_externalTextFlag;
 * std::wstring m_externalText;
 * bool m_externalTextForCalculationFlag;
 * std::wstring m_externalTextForCalculation;
 * bool m_externalColorFlag;
 * Color m_externalColor;
 * bool m_externalFontFlag;
 * Font m_externalFont;
 */
class StaticTextCalculationContext extends FormElementBaseCalculationContext 
{
	int logicRowsHeight	
	boolean logicRowsHeightPriority
	int formattedStringHeight
	boolean canSeparate = 'true'
	int rowsCnt
	int maxStringWidth
	int horAdd
	int verAdd
	String curTitleForCalculation
	boolean curTitleForCalculationInLines
	boolean externalTextFlag
    String externalText
    boolean externalTextForCalculationFlag
    String externalTextForCalculation
    
    boolean autoWidth
	String[] lines
 	boolean[] hardLines
	String[] prevLines
 	boolean[] prevHardLines 	
 	
  	boolean externalColorFlag
  	Color externalColor
  	boolean externalFontFlag
  	Font externalFont
  	
    boolean originalLengthInDLU
    TextBreakMode textBreakMode  	
    int maxWordWidth
    contains NonFormattedHeightDescr[] nonFormattedHeightDescrs
    int maxTargetWidth
	
	op void setText(String text, boolean forLengthCalculation)
	{
	    if (forLengthCalculation)
	    {
	        externalTextForCalculationFlag = true;
	        externalTextForCalculation = text;
	    }
	    else
	    {
	        externalTextFlag = true;
	        externalText = text;
	    }
	}
	
	op void setTextColor(Color clr)
	{
    	externalColorFlag = true;
    	externalColor = clr;
	}

	op void setFont(Font fnt)
	{
	    externalFontFlag = true;
	    externalFont = fnt;
	}
}

class RichElementCalculationContext extends GroupBaseCalculationContext
