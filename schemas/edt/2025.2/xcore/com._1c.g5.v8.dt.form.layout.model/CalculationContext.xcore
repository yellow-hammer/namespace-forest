 * unsigned m_columnsCount - int columnsCount
 * unsigned m_multiHeight - int multiHeight
 * std::vector<double> m_relativeWidth - double[] relativeWidth 
 * bool m_firstCallOfGetVariantTumbler - Won't transfer, redundant
 */
class TumblerCalculationContext extends FormElementBaseCalculationContext
{
	Size[] sizes
