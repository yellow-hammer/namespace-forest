    int rightTitleIndent
    int topTitleIndent
    int bottomTitleIndent
    int extTooltipHorIndent
    int extTooltipVerIndent
    int topTitleExtIndent
    int bottomTitleExtIndent
    int mobileHorIndent
    int maxWidthForRightExtTooltip
    boolean firstCallOfGetVariantRichElement
    int maxTargetHeight
    int maxTargetWidth
    FormChildrenAlign parentChildrenAlign
    HippoLayouterEdge titleEdge
    HippoLayouterEdge extTooltipEdge
}

