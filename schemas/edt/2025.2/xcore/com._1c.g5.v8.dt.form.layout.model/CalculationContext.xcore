 * bool m_verScroller;
 * unsigned m_childrenMaxAdaptiveGroupingFormGroupLevels;
 * bool m_firstCallOfGetVariantPages;
 * bool m_constantRangesInit;
 * unsigned m_constantRanges;
 * ChildInfosCache m_childInfosCache;
 */
class PagesCalculationContext extends GroupBaseCalculationContext, ElementWithLimitsBaseCalculationContext 
