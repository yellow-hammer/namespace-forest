<?xml version="1.0" encoding="ASCII"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="dbcopies" nsURI="http://g5.1c.ru/v8/dt/data-composition-system/dbcopies" nsPrefix="dbCopies">
  <eClassifiers xsi:type="ecore:EClass" name="UsedDatabaseCopiesValue">
    <eSuperTypes href="http://g5.1c.ru/v8/dt/mcore#//Value"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="value" eType="//UsedDatabaseCopies" containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="UsedDatabaseCopies">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1" eType="//UsedDatabaseCopy" containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="UsedDatabaseCopy">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" unique="false">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DatabaseCopiesUse">
    <eLiterals name="Auto"/>
    <eLiterals name="UseCopiesOnly"/>
    <eLiterals name="PreferUseCopies"/>
    <eLiterals name="DontUseCopies"/>
  </eClassifiers>
</ecore:EPackage>
