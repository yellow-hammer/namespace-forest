    Microphone = 19
    MusicLibrary = 20
    PictureAndVideoLibraries = 21
    AudioPlaybackAndVibration = 22
    BackgroundAudioPlaybackAndVibration = 23
    InstallPackages = 24
    OSBackup = 25
