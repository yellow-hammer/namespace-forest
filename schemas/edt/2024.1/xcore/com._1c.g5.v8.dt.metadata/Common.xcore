// moved from MoxelContent.xcore due to pictures support in DCS
//
// URL-picture.
//
class UrlPicture extends PictureDef
{
    String url
}

//
// Absolute picture .
//
class AbsPicture extends PictureDef
{
    Byte[] content
}

//
// Picture size mode
//
enum PictureSize
{
    RealSize = 0 // Отображение в реальном размере.
    Stretch = 1 // Растягивать.
    Proportionally = 2 // Растягивать пропорционально.
    Tile = 3 // Заполнить.
    AutoSize = 4 // Авто.
    RealSizeIgnoreScale = 5 // Отображение в реальном размере, без учета масштаба.
    AutoSizeIgnoreScale = 6 // Авто, без учета масштаба.
    ByFontSize = 7 // По размеру шрифта
}

//
// Text position relative to in-cell picture
//
enum CellTextPosition
{
    Auto = 0
    Left = 1
    Right = 2
    Top = 3
    Bottom = 4
    OnTop = 5
}

// 
// Upgraged mobile permission definition element
// since 8.3.15
//
class RequiredPermission
{
    RequiredMobileApplicationPermissions permission
    boolean use
    contains LocalStringMapEntry[] description
}

// 
// Upgraged mobile permission definition element
// since 8.3.18
//
class UsedFunctionality
{
    contains UsedFunctionalityFlag[] functionality
    contains RequiredPermissionMessage[] permissionMessage
}

class UsedFunctionalityFlag
{
    MobileApplicationFunctionalities functionality
    boolean use
}

// from mngcore/mngapp.xsd
enum MobileApplicationFunctionalities
{
    Biometrics = 0
    Location = 1
    BackgroundLocation = 2
    BluetoothPrinters = 3
    WiFiPrinters = 4
    Contacts = 5
    Calendars = 6
    PushNotifications = 7
    LocalNotifications = 8
