    ShowOnComposition = 3
}

// from xdto/core.xsd
// Может использоваться в типах (данных)
// Используется в StandardAttribute, BasicFeature, BasicTabularSection, Constant
enum FillChecking
{
    DontCheck = 0
    ShowError = 1
}

// from enums/enums.xsd
// Наверное, только в метаданных
// Используется в BasicFeature, Constant
enum FoldersAndItemsUse
{
    Items = 0
    Folders = 1
    FoldersAndItems = 2
}

// Может использоваться в типах, но пока используется только в метаданных
// Используется в Catalog, Document, DocumentNumerator и т. п. для обозначения
// длины кода или номера
// from xdto/core.xsd
enum AllowedLength
{
    Fixed = 0
    Variable = 1
}

// from xdto/core.xsd
enum MainClientApplicationWindowMode
{
    Normal = 0
    Workplace = 1
    FullscreenWorkplace = 2
    Kiosk = 3
    EmbeddedWorkplace = 4 // since 8.3.16
}

// From syntax-helper (backend)
enum SearchStringModeOnInputByString
{
    Begin = 0
    AnyPart = 1
}

// From syntax-helper (backend)
enum FullTextSearchOnInputByString
{
    Use = 0
    DontUse = 1
}

// From syntax-helper (backend)
enum ChoiceDataGetModeOnInputByString
{
    Directly = 0
    Background = 1
}

// Группа про Choice Parameter ----------------
abstract class AbstractChoiceParameterLink
{
    String[1] name
    LinkedValueChangeMode changeMode
}

// Наверное, только в метаданных
// Используется в StandardAttribute, BasicFeature, Field, Constant
// From syntax-helper (mngcore)
class ChoiceParameterLink extends AbstractChoiceParameterLink
{
    refers Field[1] field
}

// Используется только в AbstractChoiceParameterLink
// From syntax-helper (enums)
enum LinkedValueChangeMode
{
    Clear = 0
    DontChange = 1
}

// Используется там же, где и ChoiceParameterLink
// From syntax-helper (mngcore)
class ChoiceParameter
{
    String[1] name
    contains Value value
}

// --------------------------------------------
abstract class AbstractTypeLink
{
    int linkItem
}

// Наверное, только в метаданных
// Используется в StandardAttribute, BasicFeature, Constant
// From syntax-helper (mngcore)
class TypeLink extends AbstractTypeLink
{
    refers Field[1] field
}

