class AbstractMobileApplicationUrl
{
}

class MobileApplicationUrl extends AbstractMobileApplicationUrl
{
    String[1] baseUrl
    boolean useAndroid
    boolean useIOS
    boolean useWindows
}

class AllowedIncomingShareRequestType 
{
	String mime
	String uti
	String ext
	AllowedIncomingShareRequestTypeProcessingVariant processingVariant
	boolean isCustom
}

enum DefaultReportAppearanceTemplate 
{
    None as "None" = 0
    Main as "Main" = 1
    Gaudy as "Gaudy" = 2
    Sea as "Sea" = 3
    Arctic as "Arctic" = 4
    Green as "Green" = 5
    Antique as "Antique" = 6
}

//
// Плотность сжатия картинок. 
//
enum SpreadsheetDocumentSavedPicturesDensity
{
    Original = 0 // Исходная
    High = 1     // Высокая
    Medium = 2   // Средняя
    Low = 3      // Низкая
}

enum AllowedIncomingShareRequestTypeProcessingVariant 
{
	View = 0 //Просмотр
	Edit = 1 //Редактирование
}
