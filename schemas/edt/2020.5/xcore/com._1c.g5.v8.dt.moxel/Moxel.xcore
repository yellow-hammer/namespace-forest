}

//
// Тип отображения линий сводной таблицы.
//
enum PivotTableLinesShowType
{
    Auto                                            // Авто.
    Always                                          // Всегда.
}

//
// Алгориим расширения табличного документа.
//
enum ExtensionAlgorithm
{
	Replace
	Merge
}

//
// Формат области табличного документа.
//
class Format
{
    unsettable int font                             // Шрифт.
    
    unsettable int leftBorder                       // Линия левой границы. Индекс в массиве линий.
    unsettable int topBorder                        // Линия верхней границы. Индекс в массиве линий.
    unsettable int rightBorder                      // Линия правой границы. Индекс в массиве линий.
    unsettable int bottomBorder                     // Линия нижней границы. Индекс в массиве линий.
    unsettable int borderColor                      // Цвет границы. Индекс в массиве цветов. 
    
    unsettable int height                           // Высота ячейки.
    unsettable int width                            // Ширина ячейки.
    
    unsettable HorizontalAlignment horizontalAlignment  // Горизонтальное выравнивание.
    unsettable VerticalAlignment verticalAlignment  // Вертикальное выравнивание.
    
    unsettable int textColor                        // Цвет текста. Индекс в массиве цветов.
    unsettable int backColor                        // Цвет фона. Индекс в массиве цветов.
    unsettable int patternColor                     // Цвет шаблона. Индекс в массиве цветов.
    unsettable Pattern pattern                      // Шаблон заливки.
    
    unsettable TextPlacement textPlacement          // Тип размещения текста.
    unsettable FillType fillType                    // Тип заполнения.    
    
    unsettable boolean protection                   // Защита.
    unsettable boolean hidden                       // Скрыто.
    unsettable int textOrientation                  // Ориентация текста.
    unsettable DetailUse detailUse                  // Использование расшифровки.
    unsettable boolean bySelectedColumns            // По выделенным колонкам.
    unsettable boolean markNegatives                // Выделять отрицательные.
    
    unsettable boolean containsValue                // Содержит значение.
    contains unsettable TypeDescription valueType   // Тип значения.
    
    unsettable Uuid controlType                     // Тип элемента управления.
    
    unsettable boolean hyperlink                    // Гиперссылка.
    unsettable boolean quickDrag                    // Быстрое перетаскивание.
    unsettable boolean autoMarkIncomplete           // Автоматическая отметка незаполненного.
    unsettable boolean markIncomplete               // Отметка незаполненного.
    unsettable int indent                           // Отступ.
    unsettable int autoIndent                       // Автоотступ.
    
    contains unsettable LocalString dataFormat      // Формат данных.
    contains unsettable LocalString editFormat      // Формат редактирования.
    contains unsettable LocalString mask            // Маска редактирования.
    
    unsettable SizeChangeMode sizeChangeMode        // Режим изменения размера колонки.
    
    unsettable boolean print                        // Выводить на печать.
    unsettable int drawingBorder                    // Тип линии рисунка.
    unsettable boolean drawingHaveLeftBorder        // У рисунка есть граница слева.
    unsettable boolean drawingHaveTopBorder         // У рисунка есть граница сверху.
    unsettable boolean drawingHaveRightBorder       // У рисунка есть граница справа.
    unsettable boolean drawingHaveBottomBorder      // У рисунка есть граница снизу.
    
    unsettable int pictureIndex                     // index of in-cell picture
    unsettable HorizontalAlignment pictureHorizontalAlignment  // in-cell picture's horizontal alignment
    unsettable VerticalAlignment pictureVerticalAlignment = "Bottom" // in-cell picture's vertical alignment
    unsettable PictureSize pictureSize = "Proportionally"             // in-cell's picture size mode
    unsettable CellTextPosition textPosition        // text position relative to in-cell picture
    
    unsettable boolean autoWidthCalculation // is width calculated automatically
    unsettable int widthWeightFactor // width weight factor
}