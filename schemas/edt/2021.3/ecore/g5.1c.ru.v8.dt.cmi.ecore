      <eType xsi:type="ecore:EClass" href="http://g5.1c.ru/v8/dt/metadata/mdclass#//Subsystem"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="visible" lowerBound="1" containment="true" resolveProxies="false">
      <eType xsi:type="ecore:EClass" href="http://g5.1c.ru/v8/dt/metadata/mdclass#//AdjustableBoolean"/>
    </eStructuralFeatures>
