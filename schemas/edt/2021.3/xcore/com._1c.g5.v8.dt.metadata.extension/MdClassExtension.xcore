class TypeDescriptionExtension
{
    contains TypeExtension[] types
    contains NumberQualifiers numberQualifiers
    contains StringQualifiers stringQualifiers
    contains DateQualifiers dateQualifiers
    contains BinaryQualifiers binaryQualifiers
}

class TypeExtension
{
    MdPropertyState state
    refers TypeItem ^type
}

class ColumnExtension extends MdObjectExtension
{
    MdPropertyState references
}

class PredefinedItemExtension extends ObjectExtension
{
    PredefinedItemPropertyState state
}
