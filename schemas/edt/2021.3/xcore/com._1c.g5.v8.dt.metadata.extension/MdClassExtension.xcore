@GenModel(loadInitialization="false", literalsInterface="true", nonNLSMarkers="true", prefix="MdClassExtension",
    copyrightText="Copyright (C) 2016, 1C", updateClasspath="false", featureDelegation="Reflective",
    rootExtendsClass="com._1c.g5.v8.bm.core.BmObject", rootExtendsInterface="com._1c.g5.v8.bm.core.IBmObject")
@Ecore(nsPrefix="mdclassExtension", nsURI="http://g5.1c.ru/v8/dt/metadata/mdclass/extension")
package com._1c.g5.v8.dt.metadata.mdclass.^extension

