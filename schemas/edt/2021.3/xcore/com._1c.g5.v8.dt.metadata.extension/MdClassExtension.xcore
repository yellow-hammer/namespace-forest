// Extensoion features with type MdPropertyState are intended to be named exactly as native object features.
class MdObjectExtension extends ObjectExtension
{
    MdPropertyState extendedConfigurationObject
}

class BasicCommandExtension extends MdObjectExtension
{
    MdPropertyState group
    MdPropertyState commandParameterType
    MdPropertyState commandModule
    MdPropertyState picture
}

class BasicFormExtension extends MdObjectExtension
{
    MdPropertyState form
}

abstract class TypeDescriptionExtensionProvider extends TypeDescriptionProvider
{
    op TypeDescription getTypeDescription() 
    {
        TypeDescriptionExtensionProviderUtil.INSTANCE.getTypeDescription(this);
    }
}

class BasicFeatureExtension extends MdObjectExtension, TypeDescriptionExtensionProvider
{
    MdPropertyState ^type
    @MdProperty(code="Type")
    contains TypeDescriptionExtension typeExtension // since 8.3.18 has new rule for adopting type description
}

