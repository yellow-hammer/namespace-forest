interface HippoLayGroupBase extends HippoLayElementBase
{
	contains HippoLayElementBase[] children
	boolean alternativeMode
	op void addChild(HippoLayElementBase pChild) {
		if (!alternativeMode) {
			pChild.setPParent(this);
		}
		children.add(pChild);
	}
	op void insertChild(HippoLayElementBase pChild, int index) {
		if (!alternativeMode) {
			pChild.setPParent(this);
		}

		if (index >= children.size) {
			children.add(pChild);
		} else {
			children.add(index, pChild);
		}
	}
	op boolean remove(HippoLayElementBase pChild) {
		val indx = children.indexOf(pChild);

		if (indx == -1) {
			return false;
		}

		if (!alternativeMode) {
			pChild.setPParent(null);
		}
		children.remove(indx);
		return true;
	}
	op boolean move(HippoLayElementBase pChild, int offset) {
		val oldPos = children.indexOf(pChild);
		if (oldPos == -1) {
			return false;
		} else {
			children.move(oldPos + offset, pChild);
			return true;
		}
	}
	op int childIndex(HippoLayElementBase pChild) {
		children.indexOf(pChild);
	}
}

interface HippoLayGroupFormElementBase extends HippoLayGroupBase, HippoLayFormElementBase
