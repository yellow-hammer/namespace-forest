class VirtualGridElementDescription
{
	int length
	int minLengthWithNormalPriority
	int minLengthWithStretchPriority
	int maxLengthWithNormalPriority
	int maxLengthWithCompressPriority
	int narrowStandardLength
	int wideStandardLength
	int standardLength
	int slavePadding
	BitSet categoriesHolder
	String additionalData = ""
	op void setMasterSlaveName(boolean master, String name) {
		if (additionalData.isEmpty()) {
			if (master) {
				additionalData = ILayoutConstants.kHLMasterNamePrefix + name;
			} else {
				additionalData = ILayoutConstants.kHLSlaveNamePrefix + name;
			}
			return;
		}

		var otherName = "";
		var otherNamePos = -1;
		if (master) {
			otherNamePos = additionalData.indexOf(ILayoutConstants.kHLSlaveNamePrefix);
		} else {
			otherNamePos = additionalData.indexOf(ILayoutConstants.kHLMasterNamePrefix);
		}

		if (otherNamePos == -1) {
			if (master) {
				additionalData = ILayoutConstants.kHLMasterNamePrefix + name;
			} else {
				additionalData = ILayoutConstants.kHLSlaveNamePrefix + name;
			}
			return;
		}

		if (master) {
			otherNamePos += ILayoutConstants.kHLSlaveNamePrefix.length();
		} else {
			otherNamePos += ILayoutConstants.kHLMasterNamePrefix.length();
		}

		var thisNamePos = -1;
		if (master) {
			thisNamePos = additionalData.indexOf(ILayoutConstants.kHLSlaveNamePrefix);
		} else {
			thisNamePos = additionalData.indexOf(ILayoutConstants.kHLMasterNamePrefix);
		}

		if (thisNamePos != -1 && thisNamePos > otherNamePos) {
			otherName = additionalData.substring(otherNamePos, thisNamePos);
		} else {
			otherName = additionalData.substring(otherNamePos);
		}

		if (master) {
			additionalData = ILayoutConstants.kHLMasterNamePrefix + name + ILayoutConstants.kHLSlaveNamePrefix +
				otherName;
		} else {
			additionalData = ILayoutConstants.kHLSlaveNamePrefix + name + ILayoutConstants.kHLMasterNamePrefix +
				otherName;
		}
	}
	op void setCategory(HippoLayouterCategory category, boolean flag) {
		if (categoriesHolder === null) {
			categoriesHolder = new java.util.BitSet()
		}

		if (flag) {
			categoriesHolder.set(category.value)
		} else {
			categoriesHolder.clear(category.value)
		}
	}
	op boolean checkCategory(HippoLayouterCategory category) {
		if (categoriesHolder === null) {
			return false;
		} else {
			return categoriesHolder.get(category.value)
		}
	}
}

