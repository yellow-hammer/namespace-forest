interface HippoLayElementBase
{
	String title = ""
	String name = ""
	String logFormElementName = ""
	refers HippoLayElementBase pParent
	BitSet categoriesHolder //+
	boolean visible = "true"
	boolean groupVisible = "true"
	boolean enabled = "true"
	boolean groupEnabled = "true"
	boolean readOnly //+
	boolean groupReadOnly
	boolean skipOnInput
	boolean defaultControl
	boolean postGeneratorCardsInDLU
	boolean groupingVertical // real grouping of the element
	refers FormVisualEntity formModelElement
	op void setCategory(HippoLayouterCategory category, boolean flag) {
		if (categoriesHolder === null)
			categoriesHolder = new java.util.BitSet()
		if (flag) {
			categoriesHolder.set(category.value)
		} else {
			categoriesHolder.clear(category.value)
		}
	}
	op void setCategory(HippoLayouterCategory category) {
		if (categoriesHolder === null)
			categoriesHolder = new java.util.BitSet()
		categoriesHolder.set(category.value)
	}
	op boolean checkCategory(HippoLayouterCategory category) {
		if (categoriesHolder === null) {
			return false;
		} else {
			return categoriesHolder.get(category.value)
		}
	}
}

interface HippoLayFormElementBase  extends HippoLayElementBase 
{
	// На этапе генератора задаётся в стандартных символах.
	// После обработки трансформатором содержит пиксели.
	int width //+
	int minWidth //+
	int maxWidth //+
	int height //+
	int minHeight //+
	int maxHeight //+
	//
	StretchableMode stretchableMode //+
	int gridLeftPadding
	int gridTopPadding
	int gridRightPadding
	int gridBottomPadding
	int gridLeft
	int gridTop
	int gridWidth
	int gridHeight
	ItemHorizontalAlignment gridHAlign
	ItemVerticalAlignment gridVAlign
	int alignedAreaTopOffset
	String[] stickyAnchorNames
	String anchorName
	int layerNumber
	op int getGridPadding(HippoLayouterEdge edge) {
		switch (edge) {
			case HippoLayouterEdge.LEFT: {
				return gridLeftPadding;
			}
			case HippoLayouterEdge.TOP: {
				return gridTopPadding;
			}
			case HippoLayouterEdge.RIGHT: {
				return gridRightPadding;
			}
			case HippoLayouterEdge.BOTTOM: {
				return gridBottomPadding;
			}
			default: {

				//assert
				throw new IllegalArgumentException();
			}
		}
	}
	op void setGridPadding(HippoLayouterEdge edge, int padding) {
		switch (edge) {
			case HippoLayouterEdge.LEFT: {
				gridLeftPadding = padding;
				return;
			}
			case HippoLayouterEdge.TOP: {
				gridTopPadding = padding;
				return;
			}
			case HippoLayouterEdge.RIGHT: {
				gridRightPadding = padding;
				return;
			}
			case HippoLayouterEdge.BOTTOM: {
				gridBottomPadding = padding;
				return;
			}
			default:
				throw new IllegalArgumentException()
		}
	}
}

