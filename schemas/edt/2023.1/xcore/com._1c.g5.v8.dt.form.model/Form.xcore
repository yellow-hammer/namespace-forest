// enums from xcf_logform.xsd ----------------------------
enum DefaultRepresentation
{
    Auto = 0
    Text = 1
    Picture = 2
    TextPicture = 3
}

enum CommandKind
{
    Auto = 0 // Запись об автоматической команде.
    Added = 1 // Запись о добавленной команде.
}

// enums from logform.xsd ---------------------------------
enum ManagedFormFieldType
{
    None = 0
    HTMLDocumentField = 1
    InputField = 2
    GeographicalSchemaField = 3
    GraphicalSchemaField = 4
    DendrogramField = 5
    ChartField = 6
    GanttChartField = 7
    ProgressBarField = 8
    CalendarField = 9
    PictureField = 10
    LabelField = 11
    RadioButtonField = 12
    TrackBarField = 13
    SpreadsheetDocumentField = 14
    TextDocumentField = 15
    CheckBoxField = 16
    FormattedDocumentField = 17
    PlannerField = 18
    PeriodField = 19
    PDFDocumentField = 20 // since 8.3.21
}

enum ManagedFormGroupType
{
    ButtonGroup = 0
    ColumnGroup = 1
    CommandBar = 2
    UsualGroup = 3
    Popup = 4
    Page = 5
    Pages = 6
}

enum ManagedFormDecorationType
{
    Picture = 0
    Label = 1
}

enum ManagedFormAdditionType
{
    SearchStringAddition = 0
    ViewStatusAddition = 1
    SearchControlAddition = 2
}

enum ChoiceButtonRepresentation
{
    Auto = 0
    ShowInDropList = 1
    ShowInDropListAndInInputField = 2
    ShowInInputField = 3
}

enum FoldersAndItems
{
    Auto = 0
    Items = 1
    Folders = 2
    FoldersAndItems = 3
}

enum FormWindowOpeningMode
{
    Independent = 0
    LockOwnerWindow = 1
    LockWholeInterface = 2
}

enum FormEnterKeyBehavior
{
    ControlNavigation = 0
    DefaultButton = 1
}

enum AutoSaveFormDataInSettings
